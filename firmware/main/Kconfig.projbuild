menu "Lumen 灯带（#4 bring-up 临时配置）"

    # 这些名字是 #4/#6 共用的约定，后续 #6 加同名配置时不要改名。
    config LUMEN_LED_GPIO
        int "灯带数据脚 GPIO"
        range 0 21
        default 3
        help
            驱动 WS2812B DIN 的 GPIO。默认 GPIO3。

            C3FH4 上不可用/不建议用的引脚见 docs/led-bringup.md：
            GPIO12-17（封装内 flash）、GPIO18/19（USB Serial/JTAG）、
            GPIO20/21（UART0）、GPIO4-7（JTAG）、GPIO2/8/9（strapping）。
            GPIO3 不在禁用名单内。

    config LUMEN_LED_COUNT
        int "灯珠数量"
        range 1 1000
        default 30
        help
            灯带上的 WS2812B 灯珠数。协议文档默认值也是 30。

    config LUMEN_RMT_MEM_BLOCK_SYMBOLS
        int "RMT mem_block_symbols"
        range 48 1024
        default 48
        help
            每个 RMT 内存块能容纳的 symbol 数。C3 每通道只有 48 个 word，
            默认 48。C3 没有 RMT DMA，编码在 ISR 里逐块执行；中断被 BLE/Wi-Fi
            拖慢时波形会坏。调大这个值相当于加缓冲，但必须是 48 的整数倍。

    choice LUMEN_LED_COLOR_ORDER
        prompt "颜色通道顺序"
        default LUMEN_LED_COLOR_ORDER_GRB
        help
            WS2812B 芯片内部顺序是 GRB，led_strip 会按这个顺序重新排字节。
            如果点灯时红绿互换，说明灯带实际是 RGB，改这里即可。

        config LUMEN_LED_COLOR_ORDER_GRB
            bool "GRB（WS2812B 默认）"

        config LUMEN_LED_COLOR_ORDER_RGB
            bool "RGB（红绿互换的批次）"
    endchoice

endmenu
