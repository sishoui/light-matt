/*
 * 全局样式与设计变量。
 *
 * 主题：**雾蓝冷灰**（#90 从橙换成雾蓝）。浅色为默认，深色跟随系统或手动覆盖。
 * 所有颜色都走 CSS 变量——页面 wxss **不要再写死 hex**，否则深色主题下
 * 会出现白底白字。
 *
 * 变量定义在 `.page` 上（每个页面的根节点），所以同一套变量也能被页内的
 * 自定义导航栏继承；`page` 只负责兜底底色。
 *
 * **三处必须同步改**：本文件的 `.page`（浅色默认）、媒体查询里的 `.page`、
 * 以及 `.page.theme-light` / `.page.theme-dark`。改一处漏两处就会出现某个
 * 主题下的错色。同样三套值在 `components/nav-bar`、`custom-tab-bar` 与
 * `theme.json` 里各抄了一份（组件样式隔离），`tests/theme.test.ts` 会统一校验。
 *
 * 原生 `slider` / `switch` 读不到这里的变量，激活色由
 * `utils/control/theme.ts` 的 `accentColor()` 供页面数据传入。
 *
 * 手动覆盖：页面根节点加 `theme-light` / `theme-dark`（见 utils/control/theme.ts）。
 * 未加 class 时由 `prefers-color-scheme` 决定。
 */

page {
  background: #f2f4f7;
  color: #1c2430;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    "Microsoft YaHei", sans-serif;
}

.page {
  /* ---- 浅色（默认） ---- */
  --bg: #f2f4f7;
  --bg-elevated: #ffffff;
  --card: #ffffff;
  --card-2: #f6f8fa;
  --card-press: #e9eef3;
  --text: #1c2430;
  --text-2: #64707f;
  --text-3: #9aa4b1;
  --border: rgba(60, 76, 94, 0.12);
  --divider: rgba(60, 76, 94, 0.08);
  --accent: #6B8CAE;
  --accent-ink: #ffffff;
  --accent-soft: rgba(107, 140, 174, 0.14);
  --blue: #5a7ea3;
  --blue-soft: rgba(90, 126, 163, 0.14);
  --danger: #e5544b;
  --danger-soft: rgba(229, 84, 75, 0.1);
  --ok: #3aa76d;
  --ok-soft: rgba(58, 167, 109, 0.14);
  --shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.06);
  --shadow-card: 0 24rpx 64rpx rgba(0, 0, 0, 0.08);
  --radius-xl: 40rpx;
  --radius-lg: 28rpx;
  --radius-md: 20rpx;
  --radius-sm: 14rpx;

  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

@media (prefers-color-scheme: dark) {
  page {
    background: #0F1419;
    color: #e8edf3;
  }

  .page {
    --bg: #0F1419;
    --bg-elevated: #171d24;
    --card: #171d24;
    --card-2: #1f262f;
    --card-press: #29323c;
    --text: #e8edf3;
    --text-2: #93a0ae;
    --text-3: #6b7784;
    --border: rgba(255, 255, 255, 0.12);
    --divider: rgba(255, 255, 255, 0.08);
    --accent: #8FA9C4;
    --accent-ink: #101820;
    --accent-soft: rgba(143, 169, 196, 0.18);
    --blue: #7fa3c9;
    --blue-soft: rgba(127, 163, 201, 0.2);
    --danger: #ff8a8a;
    --danger-soft: rgba(255, 138, 138, 0.14);
    --ok: #4dd17a;
    --ok-soft: rgba(77, 209, 122, 0.16);
    --shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
    --shadow-card: 0 24rpx 64rpx rgba(0, 0, 0, 0.6);
  }
}

/* 手动覆盖必须放在媒体查询之后，靠源码顺序取胜。 */
.page.theme-light {
  --bg: #f2f4f7;
  --bg-elevated: #ffffff;
  --card: #ffffff;
  --card-2: #f6f8fa;
  --card-press: #e9eef3;
  --text: #1c2430;
  --text-2: #64707f;
  --text-3: #9aa4b1;
  --border: rgba(60, 76, 94, 0.12);
  --divider: rgba(60, 76, 94, 0.08);
  --accent: #6B8CAE;
  --accent-ink: #ffffff;
  --accent-soft: rgba(107, 140, 174, 0.14);
  --blue: #5a7ea3;
  --blue-soft: rgba(90, 126, 163, 0.14);
  --danger: #e5544b;
  --danger-soft: rgba(229, 84, 75, 0.1);
  --ok: #3aa76d;
  --ok-soft: rgba(58, 167, 109, 0.14);
  --shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.06);
  --shadow-card: 0 24rpx 64rpx rgba(0, 0, 0, 0.08);
  background: var(--bg);
  color: var(--text);
}

.page.theme-dark {
  --bg: #0F1419;
  --bg-elevated: #171d24;
  --card: #171d24;
  --card-2: #1f262f;
  --card-press: #29323c;
  --text: #e8edf3;
  --text-2: #93a0ae;
  --text-3: #6b7784;
  --border: rgba(255, 255, 255, 0.12);
  --divider: rgba(255, 255, 255, 0.08);
  --accent: #8FA9C4;
  --accent-ink: #101820;
  --accent-soft: rgba(143, 169, 196, 0.18);
  --blue: #7fa3c9;
  --blue-soft: rgba(127, 163, 201, 0.2);
  --danger: #ff8a8a;
  --danger-soft: rgba(255, 138, 138, 0.14);
  --ok: #4dd17a;
  --ok-soft: rgba(77, 209, 122, 0.16);
  --shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  --shadow-card: 0 24rpx 64rpx rgba(0, 0, 0, 0.6);
  background: var(--bg);
  color: var(--text);
}

/* ---------------- 连接状态条 ---------------- */

.statusbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  border-radius: var(--radius-lg);
  background: var(--card);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--text-3);
  flex-shrink: 0;
}

.link-ready .status-dot {
  background: var(--ok);
  box-shadow: 0 0 0 6rpx var(--ok-soft);
}

.link-busy .status-dot,
.link-warn .status-dot {
  background: var(--accent);
  box-shadow: 0 0 0 6rpx var(--accent-soft);
}

.link-error .status-dot {
  background: var(--danger);
  box-shadow: 0 0 0 6rpx var(--danger-soft);
}

.status-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.status-sub {
  font-size: 23rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-action {
  font-size: 27rpx;
  color: var(--accent);
  font-weight: 500;
  flex-shrink: 0;
}

/* ---------------- 卡片与区块 ---------------- */

.section {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section.disabled,
.presets.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.section-value {
  font-size: 26rpx;
  color: var(--text-2);
}

.section-hint {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

.swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border);
  box-sizing: border-box;
}

.mono {
  font-family: Menlo, Consolas, "SF Mono", monospace;
}

/* ---------------- 大开关 ---------------- */

.power-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 8rpx;
}

.power-btn {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: var(--card-2);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 160ms ease, box-shadow 160ms ease;
}

.power-btn.on {
  background: var(--accent-soft);
  border-color: var(--accent);
  box-shadow: 0 0 64rpx var(--accent-soft);
}

.power-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.power-btn.busy {
  opacity: 0.7;
  pointer-events: none;
}

/* 电源图标：圆环 + 竖线，纯 CSS，不引入图标资源 */
.power-glyph {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border: 8rpx solid var(--text-2);
  border-radius: 50%;
  border-top-color: transparent;
  box-sizing: border-box;
}

.power-btn.on .power-glyph {
  border-color: var(--accent);
  border-top-color: transparent;
}

.power-glyph::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -12rpx;
  width: 8rpx;
  height: 48rpx;
  margin-left: -4rpx;
  background: var(--text-2);
  border-radius: 4rpx;
}

.power-btn.on .power-glyph::after {
  background: var(--accent);
}

.power-label {
  font-size: 26rpx;
  color: var(--text-2);
}

/* ---------------- 滑块与读数 ---------------- */

.brightness-slider {
  margin: 8rpx 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.row-label {
  width: 84rpx;
  font-size: 23rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.row-slider {
  flex: 1;
}

.row-value {
  width: 140rpx;
  text-align: right;
  font-size: 23rpx;
  color: var(--text);
  flex-shrink: 0;
}

/* ---------------- chip（模式 / 波形 / 灯带） ---------------- */

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  flex: 1 1 40%;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  color: var(--text-2);
  background: var(--card-2);
}

.chip.selected {
  color: var(--accent-ink);
  background: var(--accent);
  font-weight: 600;
}

.chip.blue.selected {
  color: var(--blue);
  background: var(--blue-soft);
}

/* ---------------- 预设色块 ---------------- */

.presets {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12rpx 0;
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.preset {
  width: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 0;
  border-radius: 16rpx;
}

.preset-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border);
  box-sizing: border-box;
}

.preset.selected .preset-dot {
  box-shadow: 0 0 0 4rpx var(--card), 0 0 0 7rpx var(--accent);
}

.preset-name {
  font-size: 20rpx;
  color: var(--text-2);
}

.preset.selected .preset-name {
  color: var(--text);
  font-weight: 500;
}

/* ---------------- 色环 ---------------- */

.wheel-wrap {
  position: relative;
  align-self: center;
  width: 420rpx;
  height: 420rpx;
}

.wheel-canvas {
  width: 100%;
  height: 100%;
}

.color-readout {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ---------------- 段列表 ---------------- */

.seg-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.seg-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--card-2);
}

.seg-row.selected {
  background: var(--accent-soft);
}

.seg-swatch {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border);
  flex-shrink: 0;
  box-sizing: border-box;
}

.seg-index {
  font-size: 24rpx;
  color: var(--text);
  flex-shrink: 0;
}

.seg-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.seg-range {
  font-size: 24rpx;
  color: var(--text-2);
  font-family: Menlo, Consolas, "SF Mono", monospace;
}

.seg-param {
  font-size: 20rpx;
  color: var(--blue);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.seg-tag {
  font-size: 20rpx;
  color: var(--text-2);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--card-press);
}

.seg-tag.anim {
  color: var(--blue);
  background: var(--blue-soft);
}

.seg-tag.layers {
  color: var(--ok);
  background: var(--ok-soft);
}

.seg-delete {
  font-size: 22rpx;
  color: var(--danger);
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.seg-empty {
  padding: 24rpx 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}

/* ---------------- 输入与按钮 ---------------- */

.range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.range-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  color: var(--text);
  font-size: 27rpx;
  text-align: center;
}

.range-dash {
  color: var(--text-3);
  flex-shrink: 0;
}

.range-apply {
  flex-shrink: 0;
  width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-radius: var(--radius-sm);
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.range-apply.busy {
  opacity: 0.6;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.btn.primary {
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 600;
}

.btn.ghost {
  background: var(--card-2);
  color: var(--text);
}

.btn.danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.btn[disabled] {
  opacity: 0.45;
}

.btn-row {
  display: flex;
  gap: 12rpx;
}

/* ---------------- 设备行 / 信息行 ---------------- */

.device-list {
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--card-2);
}

.device-row {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid var(--divider);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  background: transparent;
}

.device-row:last-child {
  border-bottom: none;
}

.device-row.active {
  background: var(--accent-soft);
}

.device-name {
  font-size: 28rpx;
  font-weight: 500;
}

.device-meta {
  font-size: 22rpx;
  color: var(--text-2);
  font-family: Menlo, Consolas, "SF Mono", monospace;
  word-break: break-all;
}

.device-section-title {
  margin: 16rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.device-empty {
  padding: 40rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.6;
  text-align: center;
}

.scan-hint {
  font-size: 22rpx;
  color: var(--accent);
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 8rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 24rpx;
}

.info-label {
  color: var(--text-2);
  flex-shrink: 0;
}

.info-value {
  color: var(--text);
  word-break: break-all;
  text-align: right;
}

/* ---------------- 页脚 ---------------- */

.footer {
  margin-top: auto;
  padding: 24rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.version {
  font-size: 22rpx;
  color: var(--text-3);
  font-family: Menlo, Consolas, "SF Mono", monospace;
  padding: 8rpx 0;
}

.footer-hint {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: right;
}

/* ---------------- 隐藏协议日志面板（#13） ---------------- */

.log-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
}

.log-panel {
  width: 100%;
  height: 78vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-elevated);
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.log-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.log-close {
  font-size: 26rpx;
  color: var(--text-2);
  padding: 4rpx 8rpx;
}

.log-toolbar {
  display: flex;
  gap: 12rpx;
}

.log-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  font-size: 24rpx;
  color: var(--text);
}

.log-hint {
  font-size: 22rpx;
  color: var(--accent);
}

.log-list {
  flex: 1;
  min-height: 0;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  padding: 8rpx;
  box-sizing: border-box;
}

.log-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  padding: 8rpx 6rpx;
  border-bottom: 1rpx solid var(--divider);
  font-family: Menlo, Consolas, "SF Mono", monospace;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--text-2);
}

.log-row.tx .log-arrow {
  color: var(--accent);
}

.log-row.rx .log-arrow {
  color: var(--ok);
}

.log-row.bad .log-parsed {
  color: var(--danger);
}

.log-time {
  color: var(--text-3);
}

.log-hex {
  color: var(--text-2);
  word-break: break-all;
}

.log-name {
  color: var(--text);
}

.log-parsed {
  width: 100%;
  color: var(--text-2);
  word-break: break-all;
}

.log-empty {
  padding: 40rpx 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.6;
}

.log-foot {
  font-size: 20rpx;
  color: var(--text-3);
}
