/*
 * 自定义 tabBar。
 *
 * tabBar 在页面外层，拿不到 `.page` 上的主题变量，所以此处自带一套
 * --tb-* 变量，并通过 theme-light / theme-dark class 切换。
 *
 * ## 玻璃底
 *
 * 用半透明 + `backdrop-filter` 让内容从底下隐约透出来，底部因此不像
 * 一条硬边贴在内容上。没有 blur 支持的老基础库会退回接近不透明的底色——
 * 两者都保证标签可读，区别只是层次感。
 */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);

  --tb-text: #6b7684;
  --tb-on: #6B8CAE;
  --tb-bg: rgba(255, 255, 255, 0.94);
  --tb-border: rgba(60, 76, 94, 0.14);

  background: var(--tb-bg);
  border-top: 1rpx solid var(--tb-border);
}

.tabbar.theme-dark {
  --tb-text: #7e8b99;
  --tb-on: #8FA9C4;
  --tb-bg: rgba(23, 29, 36, 0.94);
  --tb-border: rgba(255, 255, 255, 0.12);
  background: var(--tb-bg);
  border-top-color: var(--tb-border);
}

/* 必须写在 .tabbar.theme-dark 之后：同特异度靠源码顺序取胜。 */
@supports (backdrop-filter: blur(1px)) {
  .tabbar {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px) saturate(1.6);
  }

  .tabbar.theme-dark {
    background: rgba(23, 29, 36, 0.82);
  }
}

/*
 * #58：底部只剩两项。用 max-width + 居中而不是 flex:1 均分整屏——
 * 两项各占 1/2 会在平板上被拉得很开，看起来像「少了点什么」。
 */
.tab {
  flex: 0 0 33%;
  max-width: 260rpx;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-label {
  font-size: 20rpx;
  color: var(--tb-text);
  line-height: 1.2;
}

.tab.on .tab-label {
  color: var(--tb-on);
  font-weight: 600;
}

.tab-glyph {
  position: relative;
  width: 44rpx;
  height: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* ---- 设备（房子） ---- */
.glyph-home-lid {
  width: 26rpx;
  height: 26rpx;
  border-left: 4rpx solid var(--tb-text);
  border-top: 4rpx solid var(--tb-text);
  transform: rotate(45deg) translate(3rpx, 3rpx);
  border-radius: 3rpx;
}

.glyph-home-body {
  width: 28rpx;
  height: 20rpx;
  border: 4rpx solid var(--tb-text);
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  margin-top: -8rpx;
  box-sizing: border-box;
}

.tab.on .glyph-home-lid {
  border-color: var(--tb-on);
}

.tab.on .glyph-home-body {
  border-color: var(--tb-on);
}

/* ---- 我的（人物轮廓：头 + 肩，纯 CSS） ---- */
.glyph-person-head {
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid var(--tb-text);
  border-radius: 50%;
  box-sizing: border-box;
}

/* 肩：圆角矩形只留上面三边，底部敞开，像半圆拱。 */
.glyph-person-body {
  width: 32rpx;
  height: 14rpx;
  border: 4rpx solid var(--tb-text);
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
  box-sizing: border-box;
  margin-top: 3rpx;
}

.tab.on .glyph-person-head {
  border-color: var(--tb-on);
}

.tab.on .glyph-person-body {
  border-color: var(--tb-on);
}
