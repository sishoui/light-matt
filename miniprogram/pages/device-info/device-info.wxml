<view class="page {{themeClass}}">
  <nav-bar
    title="设备信息"
    subtitle="{{deviceName || deviceId}}"
    back="{{true}}"
    large="{{false}}"
  />

  <view class="statusbar {{ready ? 'link-ready' : 'link-idle'}}">
    <view class="status-dot"></view>
    <view class="status-main">
      <text class="status-text">{{deviceName || '设备详情'}}</text>
      <text class="status-sub mono">{{deviceId || '未连接'}}</text>
    </view>
  </view>

  <!-- 身份：hw_id 是设备真身份（广播名会碰撞，§2） -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">身份与固件</text>
    </view>
    <view class="device-info">
      <view class="info-row">
        <text class="info-label">硬件号</text>
        <text class="info-value mono">{{hwId}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">固件</text>
        <text class="info-value">{{firmwareText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">能力</text>
        <text class="info-value">{{capsText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">上限</text>
        <text class="info-value">{{limitsText}}</text>
      </view>
    </view>
  </view>

  <!-- 逐带真实数据：灯珠数来自 State，GPIO 来自 QueryStripConfig（只读） -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">灯组</text>
      <text class="section-value">{{stripRows.length}} 条</text>
    </view>

    <!-- 总灯珠数：各灯组灯珠数之和，只读（#79） -->
    <view class="led-total">
      <text class="led-total-label">总灯珠数</text>
      <text class="led-total-value mono">{{ledTotal}} 颗</text>
    </view>

    <!--
      每组一条 1–100 的滑块（#79）：拖动只改本地值，松手（bindchange）才下发。
      SetLedCount 要重建设备的 led_strip 句柄（ACK 上限 3 秒），不能逐帧发。
    -->
    <view class="strip-info-list">
      <view wx:for="{{stripRows}}" wx:key="stripId" class="strip-info-row">
        <view class="strip-info-head">
          <text class="strip-info-name">{{item.label}}</text>
          <text class="strip-info-meta mono">{{item.ledCount}} 颗</text>
        </view>
        <slider
          class="led-slider"
          min="{{ledMin}}"
          max="{{ledMax}}"
          step="1"
          value="{{item.ledCount}}"
          disabled="{{!ready || ledBusyStripId >= 0}}"
          activeColor="{{accentColor}}"
          backgroundColor="rgba(120, 120, 128, 0.2)"
          block-size="22"
          data-strip-id="{{item.stripId}}"
          bindchanging="onLedCountChanging"
          bindchange="onLedCountChange"
        />
        <view class="strip-info-foot">
          <!-- 显示开关：本机界面偏好，永不下发（裁决 §7 从发现页搬来） -->
          <switch
            class="strip-info-switch"
            checked="{{item.visible}}"
            color="{{accentColor}}"
            data-strip-id="{{item.stripId}}"
            bindchange="onTrimStrip"
          />
          <text class="strip-info-gpio">{{item.gpioText}}</text>
        </view>
        <text wx:if="{{item.ledHint}}" class="strip-info-hint">{{item.ledHint}}</text>
      </view>
      <view wx:if="{{stripRows.length === 0}}" class="device-empty">未连接或灯控未报告灯组</view>
    </view>
    <text class="section-hint">
      拖动滑块只在松手后写入设备（重建灯带需要一点时间）；GPIO 来自构建期引脚表，协议只读
    </text>
  </view>

  <!-- 自检与危险操作 -->
  <view class="section">
    <button
      class="btn ghost"
      disabled="{{!ready || selfTestBusy}}"
      bindtap="onSelfTest"
    >{{selfTestBusy ? '自检中…' : '自检（红→绿→蓝→白）'}}</button>

    <!-- 改名：本地先写，后端异步同步（失败只影响别的手机可见性） -->
    <view class="section-head">
      <text class="section-title small">备注名</text>
      <text wx:if="{{identityHint}}" class="section-hint inline">{{identityHint}}</text>
    </view>
    <view class="remark-row">
      <input
        class="range-input"
        value="{{remarkInput}}"
        maxlength="20"
        placeholder="备注名"
        disabled="{{remarkBusy}}"
        bindinput="onRemarkInput"
      />
      <button class="range-apply" disabled="{{remarkBusy}}" bindtap="onRename">保存</button>
    </view>

    <button
      class="btn danger"
      disabled="{{!ready || disconnectBusy}}"
      bindtap="onDisconnect"
    >{{disconnectBusy ? '断开中…' : '断开连接'}}</button>
    <button class="btn danger" disabled="{{deleteBusy}}" bindtap="onDelete">
      {{deleteBusy ? '删除中…' : '删除这台设备（解除关联）'}}
    </button>
    <text class="section-hint">
      删除只解除登记关系：设备上的灯光配置不变，重新扫描仍能连上。
    </text>
    <text class="section-hint">{{hint}}</text>
  </view>
</view>
