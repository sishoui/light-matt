/* 设备详情页独有布局（共享外观在 app.wxss）。 */

.strip-info-list {
  display: flex;
  flex-direction: column;
}

.strip-info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.strip-info-row:last-child {
  border-bottom: none;
}

.strip-info-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}

.strip-info-meta {
  font-size: 22rpx;
  color: var(--text-2);
  font-family: Menlo, Consolas, monospace;
  min-width: 96rpx;
  text-align: right;
}

/* 显示的灯组开关（本机偏好，永不下发）：压在行尾，缩小默认尺寸。 */
.strip-info-switch {
  flex: 0 0 auto;
  transform: scale(0.8);
  transform-origin: right center;
}

/* 灯带选择 chip 排一行（最多 8 个，短标签） */
.chip-row.tight .chip {
  flex: 0 1 auto;
  min-width: 120rpx;
  padding: 12rpx 18rpx;
}

/* 改名行（#44）：输入框 + 保存按钮。 */
.remark-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.section-title.small {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 400;
}

.section-hint.inline {
  font-size: 20rpx;
}

