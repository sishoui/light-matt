/* 设备详情页独有布局（共享外观在 app.wxss）。 */

/* 总灯珠数：只读汇总（#79），放在灯组列表最上方。 */
.led-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-3);
  margin: var(--sp-1) 0 var(--sp-2);
  padding: var(--sp-4) var(--sp-5);
  border-radius: var(--radius-md);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.led-total-label {
  font-size: var(--fs-sm);
  color: var(--text-2);
}

.led-total-value {
  font-size: var(--fs-h3);
  font-weight: 700;
  color: var(--accent);
}

.strip-info-list {
  display: flex;
  flex-direction: column;
}

/* 每条灯组一张卡片：名称 + 数字 / 滑块 / 开关与 GPIO / 反馈（#79）。 */
.strip-info-row {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  padding: var(--sp-4) 0;
  border-bottom: 1rpx solid var(--divider);
}

.strip-info-row:last-child {
  border-bottom: none;
}

.strip-info-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-4);
}

.strip-info-name {
  flex: 1;
  font-size: var(--fs-sm);
  color: var(--text);
}

.strip-info-meta {
  font-size: var(--fs-sm);
  color: var(--text);
  font-family: Menlo, Consolas, monospace;
  text-align: right;
}

/* 1–100 的灯珠数滑块：占满整行，便于拖动（#79）。 */
.led-slider {
  width: 100%;
  margin: 0;
}

.strip-info-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  min-height: 40rpx;
}

.strip-info-gpio {
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-family: Menlo, Consolas, monospace;
}

.strip-info-hint {
  font-size: var(--fs-caption);
  color: var(--text-2);
}

/* 显示的灯组开关（本机偏好，永不下发）：行尾，缩小默认尺寸。 */
.strip-info-switch {
  flex: 0 0 auto;
  transform: scale(0.8);
  transform-origin: left center;
}

/* 改名行（#44）：输入框 + 保存按钮。 */
.remark-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-bottom: var(--sp-3);
}

.section-title.small {
  font-size: var(--fs-sm);
  color: var(--text-2);
  font-weight: 400;
}

.section-hint.inline {
  font-size: var(--fs-micro);
}

