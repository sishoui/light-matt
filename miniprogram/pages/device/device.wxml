<view class="page {{themeClass}}">
  <nav-bar
    title="{{deviceName}}"
    subtitle="{{navSubtitle}}"
    back="{{true}}"
    action-text="⋯"
    bind:action="onMenuTap"
  />

  <!-- 右上角下拉菜单（#61）：nav-bar 没有 slot，菜单在本页自建。
       遮罩层级低于 nav-bar（90），所以「菜单」按钮始终可点，再点一次收起。 -->
  <view
    wx:if="{{menuOpen}}"
    class="menu-mask"
    bindtap="onMenuClose"
    catchtouchmove="onMenuNoop"
  ></view>
  <view wx:if="{{menuOpen}}" class="menu-panel" style="top: {{menuTop}}px;">
    <view class="menu-item" bindtap="onMenuDeviceInfo" hover-class="menu-item-hover">
      <text class="menu-item-label">设备信息</text>
      <text class="menu-item-sub">固件 · 灯珠数 · 自检</text>
    </view>
    <view
      class="menu-item {{ready ? '' : 'disabled'}}"
      bindtap="onMenuDisconnect"
      hover-class="{{ready ? 'menu-item-hover' : 'none'}}"
    >
      <text class="menu-item-label">断开连接</text>
      <text class="menu-item-sub">{{ready ? '回到未连接' : '未连接'}}</text>
    </view>
  </view>

  <!-- 连接提示：自动连接失败 / 需要先扫描时才有内容 -->
  <view wx:if="{{connectHint}}" class="notice-card" bindtap="onRetryConnect">
    <text class="notice-text">{{connectHint}}</text>
    <text class="notice-action">重试</text>
  </view>

  <!-- #94：不再有整条状态栏。连接状态已收进导航栏副标题；
       未连接时下方给一行可点的重试提示（点它重连）。 -->
  <view
    wx:if="{{!ready && !connectBusy}}"
    class="retry-strip {{linkClass}}"
    bindtap="onRetryConnect"
    hover-class="retry-strip-hover"
  >
    <text class="retry-text">{{statusText}}</text>
    <text class="retry-action">重连</text>
  </view>

  <!-- ---------------- 设备级：总开关 + 整台设备的亮度 ---------------- -->
  <view class="control-card {{ready ? '' : 'disabled'}}">
    <view class="power-card">
      <view
        class="power-btn {{power ? 'on' : ''}} {{!ready ? 'disabled' : ''}} {{powerBusy ? 'busy' : ''}}"
        bindtap="onTogglePower"
        hover-class="power-btn-hover"
      >
        <view class="power-glyph"></view>
      </view>
      <text class="power-label">{{powerLabel}}</text>
    </view>

    <!-- 亮度：min/max 来自设备 State，不硬编码 255；显示百分比 -->
    <view class="brightness-block">
      <view class="section-head">
        <text class="section-title">整台亮度</text>
        <text class="section-value">{{brightnessPercent}}%</text>
      </view>
      <slider
        class="brightness-slider"
        min="0"
        max="{{maxBrightness}}"
        step="1"
        value="{{brightness}}"
        disabled="{{!ready}}"
        activeColor="{{accentColor}}"
        backgroundColor="rgba(120, 120, 128, 0.2)"
        block-size="26"
        bindchanging="onBrightnessChanging"
        bindchange="onBrightnessChange"
      />
      <text class="section-hint">{{brightnessHintText}}</text>
    </view>
  </view>

  <!-- ---------------- 灯组：两列卡片 ---------------- -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">灯组</text>
      <text class="section-value">{{stripCards.length}} 组</text>
    </view>

    <!-- v5：一列排布，左封面 / 中名称与部位数 / 右开关。点行**就地展开**部位列表。 -->
    <view wx:if="{{stripCards.length > 0}}" class="strip-list {{ready ? '' : 'disabled'}}">
      <block wx:for="{{stripCards}}" wx:key="stripId">
        <view
          class="strip-row {{item.on ? '' : 'off'}} {{item.expanded ? 'expanded' : ''}}"
          data-strip-id="{{item.stripId}}"
          bindtap="onStripCardTap"
          bindlongpress="onStripCardLongPress"
          hover-class="strip-row-hover"
        >
          <image wx:if="{{item.photo}}" class="strip-cover" src="{{item.photo}}" mode="aspectFill" />
          <view wx:else class="strip-cover strip-cover-fallback"></view>

          <view class="strip-row-main">
            <view class="strip-row-title-line">
              <text class="strip-row-title">{{item.label}}</text>
              <text class="strip-chevron">{{item.expanded ? '▾' : '▸'}}</text>
            </view>
            <text class="strip-row-meta">{{item.ledCount}} 颗 · {{item.summary}}</text>
          </view>

          <!-- catchtap 拦住冒泡：点开关不能顺带展开。
               开关自己的状态变化走 bindchange（change 与 tap 是两条独立事件）。 -->
          <view class="strip-switch" catchtap="onStripSwitchBlock">
            <switch
              checked="{{item.on}}"
              color="{{accentColor}}"
              disabled="{{!ready || item.busy}}"
              data-strip-id="{{item.stripId}}"
              bindchange="onStripPowerChange"
            />
          </view>
        </view>

        <!-- 展开区：部位列表（#155）。空态给一个「+」播种入口。 -->
        <view wx:if="{{item.expanded}}" class="part-list">
          <text wx:if="{{item.partsLoading}}" class="part-hint">正在读取部位…</text>
          <text wx:elif="{{item.emptyHint}}" class="part-hint">{{item.emptyHint}}</text>

          <view
            wx:for="{{item.parts}}"
            wx:for-item="part"
            wx:key="partId"
            class="part-row {{part.on ? '' : 'off'}}"
            data-strip-id="{{part.stripId}}"
            data-part-id="{{part.partId}}"
            bindtap="onPartRowTap"
            hover-class="part-row-hover"
          >
            <view class="part-row-main">
              <text class="part-row-title">{{part.label}}</text>
              <text class="part-row-meta">{{part.rangeText}} · {{part.pixelCount}} 颗</text>
              <text class="part-row-meta">{{part.stepSummary}}</text>
            </view>
            <view class="strip-switch" catchtap="onPartSwitchBlock">
              <switch
                checked="{{part.on}}"
                color="{{accentColor}}"
                disabled="{{!ready || part.busy}}"
                data-strip-id="{{part.stripId}}"
                data-part-id="{{part.partId}}"
                bindchange="onPartSwitchChange"
              />
            </view>
          </view>

          <view
            wx:if="{{!item.partsLoading}}"
            class="part-add"
            data-strip-id="{{item.stripId}}"
            catchtap="onSeedPartTap"
            hover-class="part-row-hover"
          >
            <text class="part-add-text">+ 添加部位（整条 · 1 步 · 常亮）</text>
          </view>
        </view>
      </block>
    </view>

    <text wx:else class="section-hint">
      {{ready ? '没有可见的灯组' : '连接后显示灯组'}}
    </text>
    <text wx:if="{{ready && stripCards.length > 0}}" class="section-hint">
      点一行展开部位，再点部位进入编辑；长按可改名或换封面
    </text>
  </view>

  <!-- ---------------- 底部：只读设备摘要 + 设备信息入口 ---------------- -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">设备摘要</text>
    </view>
    <view class="summary-list">
      <view class="summary-row">
        <text class="summary-label">固件版本</text>
        <text class="summary-value mono">{{firmwareText}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">硬件号</text>
        <text class="summary-value mono">{{hwId}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">灯组数</text>
        <text class="summary-value">{{stripCount}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">灯珠总数</text>
        <text class="summary-value">{{ledTotal}}</text>
      </view>
    </view>

    <view class="link-row summary-link" bindtap="onGoDeviceInfo" hover-class="link-row-hover">
      <text class="link-label">设备信息</text>
      <text class="link-value">固件 · 灯珠数 · 自检</text>
      <view class="link-chevron"></view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-hint">开关与灯控状态以灯控为准{{mock ? '（演示模式）' : ''}}</text>
  </view>

  <!-- ============ 灯组长按菜单（#94） ============ -->
  <view wx:if="{{stripMenuOpen}}" class="menu-mask sheet-mask" bindtap="onStripMenuClose"></view>
  <view wx:if="{{stripMenuOpen}}" class="sheet">
    <view class="sheet-grabber"></view>
    <view class="sheet-head">
      <text class="sheet-title">{{stripMenuName}}</text>
      <text class="sheet-sub">灯组动作</text>
    </view>
    <view class="sheet-item" bindtap="onStripMenuRename" hover-class="sheet-item-hover">
      <text class="sheet-item-label">修改名称</text>
      <text class="sheet-item-sub">{{stripMenuName}}</text>
    </view>
    <view class="sheet-item" bindtap="onStripMenuPickPhoto" hover-class="sheet-item-hover">
      <text class="sheet-item-label">更换封面</text>
      <text class="sheet-item-sub">从相册选择</text>
    </view>
    <view
      class="sheet-item {{stripMenuPhotoIsCustom ? '' : 'disabled'}}"
      bindtap="onStripMenuClearPhoto"
      hover-class="{{stripMenuPhotoIsCustom ? 'sheet-item-hover' : 'none'}}"
    >
      <text class="sheet-item-label">移除封面</text>
      <text class="sheet-item-sub">{{stripMenuPhotoIsCustom ? '恢复默认占位图' : '当前是默认封面'}}</text>
    </view>
    <view class="sheet-cancel" bindtap="onStripMenuClose">取消</view>
  </view>
</view>
