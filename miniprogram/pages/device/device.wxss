/*
 * 设备详情页（原「灯光」页 + 连接语义）。
 * 共享外观在 app.wxss，这里只放本页独有布局。
 */

/* ---------------- 连接提示 ---------------- */

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-lg);
  background: var(--danger-soft);
}

.notice-text {
  flex: 1;
  font-size: 23rpx;
  color: var(--danger);
  line-height: 1.5;
}

.notice-action {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--danger);
  flex-shrink: 0;
}

/* ---------------- 灯带切换器 ---------------- */

.strip-switcher {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.strip-switcher.disabled {
  opacity: 0.45;
}

/* 8 条带横向滚动，不换行：换行会把下面的开关挤出首屏。 */
.strip-scroll {
  width: 100%;
  white-space: nowrap;
}

.strip-chip-row {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.strip-chip {
  flex: 0 0 auto;
  min-width: 200rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  transition: background 160ms ease;
}

.strip-chip-hover {
  background: var(--card-press);
}

.strip-chip.selected {
  background: var(--accent-soft);
  box-shadow: 0 0 0 2rpx var(--accent);
}

/* 关着的带整体压暗，但文字仍可读（要能看见灯珠数与段数）。 */
.strip-chip.off {
  opacity: 0.6;
}

.strip-chip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.strip-chip-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}

/* 动画提示点：只作显示（协议 §9.1 明确它不能当正确性依据）。 */
.strip-anim-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--blue);
  flex-shrink: 0;
}

.strip-chip-sub {
  font-size: 21rpx;
  color: var(--text-2);
  white-space: nowrap;
}

.strip-empty {
  padding: 24rpx 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---------------- 控制卡（电源 + 本条带开关） ---------------- */

.control-card {
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 16rpx 28rpx 28rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.control-card.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.power-btn-hover {
  opacity: 0.85;
}

.strip-power-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--divider);
}

.strip-power-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.strip-power-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
}

/* ---------------- 段列表补充 ---------------- */

.seg-head-actions {
  display: flex;
  gap: 24rpx;
}

.section-action {
  font-size: 25rpx;
  color: var(--accent);
  font-weight: 500;
}

.seg-row-hover {
  background: var(--card-press);
}

.seg-edit {
  font-size: 22rpx;
  color: var(--blue);
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

/* ---------------- 其他入口 ---------------- */

.link-list {
  border-radius: var(--radius-lg);
  background: var(--card);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.link-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--divider);
}

.link-row:last-child {
  border-bottom: none;
}

.link-row-hover {
  background: var(--card-press);
}

.link-label {
  font-size: 28rpx;
  color: var(--text);
  min-width: 140rpx;
}

.link-value {
  flex: 1;
  font-size: 23rpx;
  color: var(--text-2);
  text-align: right;
}

.link-chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--text-3);
  border-top: 3rpx solid var(--text-3);
  transform: rotate(45deg);
  flex-shrink: 0;
}
