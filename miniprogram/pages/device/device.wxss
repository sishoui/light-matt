/*
 * 设备详情页（#63 瘦身：只管设备级）。
 * 共享外观在 app.wxss，这里只放本页独有布局。
 *
 * 页面职责：总开关 + 整台亮度（顶部）、灯组两列卡片（中间）、
 * 只读设备摘要 + 设备信息入口（底部）。灯效编辑控件全部不在这里。
 */

/* ---------------- 连接提示 ---------------- */

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-5);
  padding: var(--sp-6) var(--sp-7);
  border-radius: var(--radius-lg);
  background: var(--danger-soft);
}

.notice-text {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--danger);
  line-height: 1.5;
}

.notice-action {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--danger);
  flex-shrink: 0;
}

/* ---------------- 控制卡（总开关 + 整台亮度） ---------------- */

.control-card {
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: var(--sp-4) var(--sp-7) var(--sp-7);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.control-card.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.power-btn-hover {
  opacity: 0.85;
}

.brightness-block {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  padding-top: var(--sp-5);
  border-top: 1rpx solid var(--divider);
}

/* ---------------- 灯组一列卡片（#94） ----------------
 *
 * 左封面 / 中名称与灯珠数 / 右开关。封面没有时用占位图（按灯组号固定分配）。
 */
.strip-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.strip-list.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.strip-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--sp-5);
  padding: var(--sp-4);
  border-radius: var(--radius-md);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  transition: background 160ms ease;
}

.strip-row-hover {
  background: var(--card-press);
}

/* 这一组关着：整体压暗，但文字仍要能读（要看得到灯珠数与效果）。 */
.strip-row.off {
  opacity: 0.6;
}

.strip-cover {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--card-press);
}

.strip-cover-fallback {
  background: var(--accent-soft);
}

.strip-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.strip-row-title-line {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-width: 0;
}

.strip-row-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 动画提示点：只作显示（协议 §9.1 明确它不能当正确性依据）。 */
.strip-anim-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--blue);
  flex-shrink: 0;
}

.strip-row-meta {
  font-size: var(--fs-caption);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 开关在一行内右对齐；缩放一点避免挤掉文字。 */
.strip-switch {
  display: flex;
  align-items: center;
}

.strip-switch switch {
  transform: scale(0.85);
  transform-origin: left center;
}

/* ---------------- 只读设备摘要 ---------------- */

.summary-list {
  display: flex;
  flex-direction: column;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--divider);
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: var(--fs-sm);
  color: var(--text-2);
}

.summary-value {
  font-size: var(--fs-sm);
  color: var(--text);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 摘要卡里的入口行：去掉外层圆角与阴影（已在大卡内）。 */
.summary-link {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0;
}

/* ---------------- 其他入口 ---------------- */

.link-row {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-7);
  border-bottom: 1rpx solid var(--divider);
}

.link-row:last-child {
  border-bottom: none;
}

.link-row-hover {
  background: var(--card-press);
}

.link-label {
  font-size: var(--fs-body);
  color: var(--text);
  min-width: 140rpx;
}

.link-value {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--text-2);
  text-align: right;
}

.link-chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--text-3);
  border-top: 3rpx solid var(--text-3);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ---------------- 右上角下拉菜单（#61） ----------------
 * nav-bar 组件没有 slot，菜单只能在页面里自建：
 *  - 遮罩 z-index 85 低于 nav-bar 的 90 —— 「菜单」按钮永远点得到，
 *    再点一次收起（不会先被遮罩吞掉）；
 *  - 面板从 nav-bar 下边界开始，z-index 86，仍在 nav-bar 之下但高于内容。
 */
.menu-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 85;
  background: rgba(0, 0, 0, 0.18);
}

.menu-panel {
  position: fixed;
  right: 24rpx;
  z-index: 86;
  min-width: 300rpx;
  padding: var(--sp-2) 0;
  border-radius: var(--radius-lg);
  background: var(--bg-elevated);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-6);
  padding: var(--sp-5) var(--sp-7);
}

.menu-item-hover {
  background: var(--card-press);
}

.menu-item.disabled {
  opacity: 0.4;
}

.menu-item-label {
  font-size: var(--fs-body);
  color: var(--text);
}

.menu-item-sub {
  font-size: var(--fs-micro);
  color: var(--text-3);
}

.menu-item.disabled .menu-item-label {
  color: var(--text-3);
}

/* ---------------- 未连接时的重试提示（#94） ----------------
 *
 * 不再是一整条状态栏：连接状态在导航栏副标题里，这里只在未连接时给
 * 一行可点的重试入口。
 */
.retry-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
  padding: var(--sp-4) var(--sp-6);
  border-radius: var(--radius-md);
  background: var(--card);
  border: 1rpx solid var(--border);
}

.retry-strip-hover {
  background: var(--card-press);
}

.retry-text {
  font-size: var(--fs-sm);
  color: var(--text-2);
}

.retry-action {
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--accent);
}

/* ---------------- 底部弹层（灯组长按菜单，#94） ---------------- */

.sheet-mask {
  z-index: 118;
  background: rgba(0, 0, 0, 0.42);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  background: var(--bg-elevated);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--sp-4) var(--sp-7) calc(var(--sp-7) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  box-sizing: border-box;
  animation: device-sheet-rise 180ms ease-out;
}

@keyframes device-sheet-rise {
  from {
    transform: translateY(24rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--card-press);
  align-self: center;
  margin-bottom: var(--sp-2);
}

.sheet-head {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  padding: var(--sp-2) var(--sp-2) var(--sp-4);
  border-bottom: 1rpx solid var(--divider);
  margin-bottom: var(--sp-2);
}

.sheet-title {
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.3rpx;
  color: var(--text);
}

.sheet-sub {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.sheet-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-6);
  padding: var(--sp-6) var(--sp-2);
  border-bottom: 1rpx solid var(--divider);
}

.sheet-item:last-of-type {
  border-bottom: none;
}

.sheet-item-hover {
  background: var(--card-press);
}

.sheet-item.disabled {
  opacity: 0.4;
}

.sheet-item-label {
  font-size: var(--fs-h3);
  color: var(--text);
}

.sheet-item-sub {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.sheet-item.disabled .sheet-item-label {
  color: var(--text-3);
}

.sheet-cancel {
  margin-top: var(--sp-3);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--card-2);
  font-size: var(--fs-body);
  color: var(--text-2);
}

/* ---------------- 部位展开区（v5 / #155） ----------------
 *
 * 一行灯组展开后列出它的部位。视觉上是**缩进一级**的卡片：左边界与封面
 * 左沿对齐，右侧留出开关的宽度，这样「组 → 部位」的层级一眼可见。
 */

.strip-chevron {
  margin-left: auto;
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.strip-row.expanded {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

.part-list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 0 0 8rpx 0;
  background: var(--card-2);
  border-radius: 0 0 var(--radius-md) var(--radius-md);
}

.part-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4) var(--sp-3) calc(var(--sp-4) + 96rpx);
  background: transparent;
}

.part-row.off {
  opacity: 0.55;
}

.part-row-hover {
  background: var(--card-press);
}

.part-row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.part-row-title {
  font-size: var(--fs-body);
  color: var(--text);
}

.part-row-meta {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.part-hint {
  padding: var(--sp-3) var(--sp-4) var(--sp-3) calc(var(--sp-4) + 96rpx);
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.part-add {
  margin: 0 var(--sp-4) var(--sp-2) calc(var(--sp-4) + 96rpx);
  padding: var(--sp-3) var(--sp-4);
  border: 1rpx dashed var(--border-strong);
  border-radius: var(--radius-sm);
}

.part-add-text {
  font-size: var(--fs-caption);
  color: var(--accent);
}
