/*
 * 设备详情页（#63 瘦身：只管设备级）。
 * 共享外观在 app.wxss，这里只放本页独有布局。
 *
 * 页面职责：总开关 + 整台亮度（顶部）、灯组两列卡片（中间）、
 * 只读设备摘要 + 设备信息入口（底部）。灯效编辑控件全部不在这里。
 */

/* ---------------- 连接提示 ---------------- */

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-lg);
  background: var(--danger-soft);
}

.notice-text {
  flex: 1;
  font-size: 23rpx;
  color: var(--danger);
  line-height: 1.5;
}

.notice-action {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--danger);
  flex-shrink: 0;
}

/* ---------------- 控制卡（总开关 + 整台亮度） ---------------- */

.control-card {
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 16rpx 28rpx 28rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.control-card.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.power-btn-hover {
  opacity: 0.85;
}

.brightness-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--divider);
}

/* ---------------- 灯组两列卡片 ---------------- */

.strip-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.strip-grid.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.strip-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  transition: background 160ms ease;
}

.strip-card-hover {
  background: var(--card-press);
}

/* 这一组关着：整体压暗，但文字仍要能读（要看得到灯珠数与效果）。 */
.strip-card.off {
  opacity: 0.6;
}

.strip-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.strip-card-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}

/* 动画提示点：只作显示（协议 §9.1 明确它不能当正确性依据）。 */
.strip-anim-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--blue);
  flex-shrink: 0;
}

.strip-card-leds {
  font-size: 21rpx;
  color: var(--text-2);
}

.strip-card-summary {
  font-size: 22rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.strip-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--divider);
}

/* 开关在卡片内右对齐；缩放一点避免挤掉文字。 */
.strip-switch {
  display: flex;
  align-items: center;
}

.strip-switch switch {
  transform: scale(0.85);
  transform-origin: left center;
}

/* ---------------- 只读设备摘要 ---------------- */

.summary-list {
  display: flex;
  flex-direction: column;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: 25rpx;
  color: var(--text-2);
}

.summary-value {
  font-size: 25rpx;
  color: var(--text);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 摘要卡里的入口行：去掉外层圆角与阴影（已在大卡内）。 */
.summary-link {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0;
}

/* ---------------- 其他入口 ---------------- */

.link-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--divider);
}

.link-row:last-child {
  border-bottom: none;
}

.link-row-hover {
  background: var(--card-press);
}

.link-label {
  font-size: 28rpx;
  color: var(--text);
  min-width: 140rpx;
}

.link-value {
  flex: 1;
  font-size: 23rpx;
  color: var(--text-2);
  text-align: right;
}

.link-chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--text-3);
  border-top: 3rpx solid var(--text-3);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ---------------- 右上角下拉菜单（#61） ----------------
 * nav-bar 组件没有 slot，菜单只能在页面里自建：
 *  - 遮罩 z-index 85 低于 nav-bar 的 90 —— 「菜单」按钮永远点得到，
 *    再点一次收起（不会先被遮罩吞掉）；
 *  - 面板从 nav-bar 下边界开始，z-index 86，仍在 nav-bar 之下但高于内容。
 */
.menu-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 85;
  background: rgba(0, 0, 0, 0.18);
}

.menu-panel {
  position: fixed;
  right: 24rpx;
  z-index: 86;
  min-width: 300rpx;
  padding: 8rpx 0;
  border-radius: var(--radius-lg);
  background: var(--bg-elevated);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border);
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 28rpx;
}

.menu-item-hover {
  background: var(--card-press);
}

.menu-item.disabled {
  opacity: 0.4;
}

.menu-item-label {
  font-size: 28rpx;
  color: var(--text);
}

.menu-item-sub {
  font-size: 20rpx;
  color: var(--text-3);
}

.menu-item.disabled .menu-item-label {
  color: var(--text-3);
}
