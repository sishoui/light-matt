/* 发现页独有布局（共享外观在 app.wxss）。 */

.section-action {
  font-size: 25rpx;
  color: var(--accent);
  font-weight: 500;
}

.section-title.small {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 400;
}

.section-hint.inline {
  font-size: 20rpx;
}

.section-subhead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.remark-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.strip-trim-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.strip-trim-row:last-child {
  border-bottom: none;
}

.strip-trim-label {
  font-size: 25rpx;
  color: var(--text);
}

/* ---------------- 同步提示（#44） ---------------- */

.sync-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--accent-soft);
}

.sync-text {
  font-size: 22rpx;
  color: var(--text-2);
}

.sync-action {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 500;
}

.identity-hint {
  display: block;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ---------------- 我的设备行 ---------------- */

.device-item {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid var(--divider);
}

.device-item:last-child {
  border-bottom: none;
}

.device-item .device-row {
  flex: 1;
  border-bottom: none;
  /* 页内行是「左名称 / 右灯带数」两栏，覆盖 app.wxss 的纵向布局。 */
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.device-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.device-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-meta {
  font-size: 20rpx;
  color: var(--text-3);
  font-family: Menlo, Consolas, "SF Mono", monospace;
  word-break: break-all;
}

.device-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex: 0 0 auto;
}

.device-strips {
  font-size: 22rpx;
  color: var(--text-2);
}

/* 缓存 / 上次：不是设备当前配置，弱化处理。 */
.device-strips.cached {
  color: var(--text-3);
}

.device-badge {
  font-size: 18rpx;
  color: var(--accent);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
}

.device-badge.ghost {
  color: var(--text-2);
  background: var(--card-press);
}

.device-delete {
  flex: 0 0 auto;
  width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--danger);
  border-left: 1rpx solid var(--divider);
}

/* ---------------- 外观分段控件 ---------------- */

.segmented {
  display: flex;
  padding: 6rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
}

.segment {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--text-2);
  transition: background 160ms ease;
}

.segment.on {
  background: var(--card);
  color: var(--text);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 自定义 tabBar 是 fixed 的，本页内容要让出它的高度。 */
.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
