/*
 * 发现页（#92）：清单式扫描 + 添加设备表单弹层。
 *
 * 颜色一律走主题变量。这里刻意不写死 hex——浅色/深色切换时本页也换。
 */

/* ---------------- 搜索条 ---------------- */

.searchbar {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  height: 72rpx;
  padding: 0 var(--sp-5);
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--card-2);
  border: 1rpx solid var(--border);
}

.search-glyph {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.search-glyph-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid var(--text-3);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-glyph-handle {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--text-3);
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: var(--fs-body);
  color: var(--text);
}

.search-placeholder {
  color: var(--text-3);
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--card-press);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-hover {
  opacity: 0.7;
}

/* 一个叉：两条短斜线。 */
.search-clear-x {
  position: relative;
  width: 18rpx;
  height: 18rpx;
}

.search-clear-x::before,
.search-clear-x::after {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 18rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: var(--text-2);
}

.search-clear-x::before {
  transform: rotate(45deg);
}

.search-clear-x::after {
  transform: rotate(-45deg);
}

/* ---------------- 分组标题 ---------------- */

.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--sp-1) var(--sp-1) 0;
}

.group-title {
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.group-count {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ---------------- 清单行 ---------------- */

.scan-row {
  flex-direction: row;
  align-items: center;
  gap: var(--sp-5);
  padding: var(--sp-5);
  border-radius: var(--radius-md);
  background: var(--card);
  border: 1rpx solid var(--border);
}

.scan-row-hover {
  background: var(--card-press);
}

.scan-row.active {
  border-color: var(--accent);
}

.row-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--card-2);
}

.row-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft);
}

.row-cover-initial {
  font-size: var(--fs-h1);
  font-weight: 700;
  color: var(--accent);
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.row-title-line {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  min-width: 0;
}

.row-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-badge {
  font-size: var(--fs-micro);
  color: var(--accent);
  padding: var(--sp-1) var(--sp-3);
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  flex-shrink: 0;
}

.row-badge.ghost {
  color: var(--text-2);
  background: var(--card-press);
}

.row-sub-line {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}

.row-signal-text {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* 四格信号条：柱高递增，未点亮的格子走底色。 */
.signal-bars {
  display: flex;
  align-items: flex-end;
  gap: var(--sp-1);
  height: 22rpx;
}

.signal-bar {
  width: 5rpx;
  border-radius: 2rpx;
  background: var(--card-press);
}

.signal-bar.bar-0 {
  height: 8rpx;
}

.signal-bar.bar-1 {
  height: 12rpx;
}

.signal-bar.bar-2 {
  height: 17rpx;
}

.signal-bar.bar-3 {
  height: 22rpx;
}

.signal-bar.lit {
  background: var(--accent);
}

.row-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-3);
  border-right: 3rpx solid var(--text-3);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ---------------- 空态 ---------------- */

.empty-state {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  align-items: center;
  padding: var(--sp-10) var(--sp-7);
  border-radius: var(--radius-lg);
  background: var(--card);
  border: 1rpx solid var(--border);
}

.empty-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--text);
  text-align: center;
}

.empty-hint {
  font-size: var(--fs-caption);
  color: var(--text-3);
  text-align: center;
  line-height: 1.7;
}

.scan-hint {
  font-size: var(--fs-caption);
  color: var(--danger);
  padding: 0 var(--sp-1);
  line-height: 1.6;
}

/* ---------------- 底部按钮 ---------------- */

.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-3);
  margin-top: var(--sp-2);
}

.rescan-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: var(--fs-h3);
}

.rescan-btn.busy {
  opacity: 0.7;
}

.actions-hint {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ---------------- 底部弹层（添加设备表单） ---------------- */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: var(--bg-elevated);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--sp-4) var(--sp-7) calc(var(--sp-7) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: var(--sp-6);
  max-height: 84vh;
  box-sizing: border-box;
  animation: sheet-rise 180ms ease-out;
}

@keyframes sheet-rise {
  from {
    transform: translateY(24rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--card-press);
  align-self: center;
}

.sheet-head {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.sheet-title {
  font-size: var(--fs-h2);
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--text);
}

.sheet-sub {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.sheet-note {
  font-size: var(--fs-caption);
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: var(--radius-sm);
  padding: var(--sp-3) var(--sp-4);
  line-height: 1.5;
}

.field {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.field-label {
  font-size: var(--fs-caption);
  color: var(--text-2);
  padding-left: var(--sp-1);
}

.field-input {
  height: 88rpx;
  padding: 0 var(--sp-6);
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--card-2);
  border: 1rpx solid var(--border);
  font-size: var(--fs-h3);
  color: var(--text);
}

.field-placeholder {
  color: var(--text-3);
}

.cover-picker {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
  border: 1rpx dashed var(--border);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-picker-hover {
  opacity: 0.75;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-2);
}

/* 加号：两条短线。 */
.cover-plus {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.cover-plus::before,
.cover-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 2rpx;
  background: var(--text-3);
}

.cover-plus::before {
  width: 34rpx;
  height: 3rpx;
  margin: -1rpx 0 0 -17rpx;
}

.cover-plus::after {
  width: 3rpx;
  height: 34rpx;
  margin: -17rpx 0 0 -1rpx;
}

.cover-empty-text {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.cover-remove {
  font-size: var(--fs-caption);
  color: var(--danger);
  padding-left: var(--sp-1);
}

.sheet-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: var(--fs-h3);
  margin-top: var(--sp-2);
}

.sheet-hint {
  font-size: var(--fs-caption);
  color: var(--text-3);
  text-align: center;
}
