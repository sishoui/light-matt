/*
 * 首页：方形大卡（图片铺满 + 信息叠底）+ 其他设备小图。
 *
 * 卡片是 1:1 的接近满宽方块，占据首屏大半。图片用 absolute 铺满，
 * 信息层用 flex 压到底部，中间留空——这样换成真实照片时布局不变。
 *
 * 文字可读性靠两层保证：
 *  1. `.hero-scrim` 的纵向渐变（图底部压暗）；
 *  2. 文字自身的轻微投影（极暗照片上也不糊）。
 */

.page {
  padding-top: 0;
  /* 自定义 tabBar 是 fixed 的，内容必须自己让出它的高度。 */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ---------------- 空态 ---------------- */

.empty-card {
  margin-top: 40rpx;
  padding: 80rpx 40rpx;
  border-radius: var(--radius-xl);
  background: var(--card);
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-card-hover {
  background: var(--card-press);
}

.empty-glyph {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.empty-glyph-ring {
  width: 104rpx;
  height: 104rpx;
  border: 6rpx solid var(--border);
  border-radius: 50%;
  box-sizing: border-box;
}

.empty-glyph-dot {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--text-3);
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
  max-width: 460rpx;
}

.empty-cta {
  margin-top: 16rpx;
  padding: 18rpx 56rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 27rpx;
  font-weight: 600;
}

/* ---------------- 方形大卡 ---------------- */

.hero-card {
  position: relative;
  /* 1:1 方形：宽度撑满（页面左右各 32rpx 内边距），高度由 aspect-ratio 决定。
   * 兼容写法：先用 padding-top:100% 撑高（老基础库不支持 aspect-ratio）。 */
  width: 100%;
  height: 0;
  padding-top: 100%;
  margin-top: 8rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform 180ms ease;
}

.hero-card-hover {
  transform: scale(0.985);
}

/* 封面图：绝对定位铺满整个方形 */
.hero-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 没有照片时的兜底：用设备色 + 亮度画渐变（和状态一致，不假装是照片）。 */
.hero-photo-fallback {
  background:
    radial-gradient(120% 100% at 62% 28%, var(--accent-soft), transparent 72%),
    var(--card);
}

/* 压暗层：底部最暗，保证标题在亮照片上也读得清 */
.hero-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.28) 0%,
    rgba(0, 0, 0, 0.04) 26%,
    rgba(0, 0, 0, 0.16) 58%,
    rgba(0, 0, 0, 0.62) 100%
  );
  pointer-events: none;
}

/* 关灯 / 离线：整卡压暗，避免「明明没开却亮着」的错觉 */
.hero-card.tone-off .hero-photo,
.hero-card.tone-offline .hero-photo,
.hero-card.tone-stale .hero-photo {
  filter: grayscale(0.55) brightness(0.62);
}

/* ---------------- 卡内上层：状态 + 电源 ---------------- */

.hero-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx 32rpx 0;
}

.hero-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  /* 半透明底：在照片上也读得清 */
  background: rgba(0, 0, 0, 0.32);
}

.hero-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}

/*
 * 大卡上的状态点是**压在图片/压暗层之上**的固定亮色，不跟随主题：
 * 这里的两处 hex 是有意保留的（背景恒定偏暗，浅色主题变量会看不清）。
 * 取值与雾蓝主题同族——关灯态用浅雾蓝而不是旧的暖橙。
 */
.tone-on .hero-dot {
  background: #7fd39a;
}

.tone-off .hero-dot {
  background: #a8c0d8;
}

.hero-status-text {
  font-size: 23rpx;
  /* 固定用白色：这里压在图片上，主题变量不适用 */
  color: rgba(255, 255, 255, 0.94);
}

/* 电源键：半透明玻璃质感，压在照片上 */
.hero-power {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.34);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 160ms ease;
}

.hero-power.on {
  background: rgba(107, 140, 174, 0.94);
  border-color: rgba(255, 255, 255, 0.4);
}

.hero-power-hover {
  opacity: 0.75;
}

.hero-power.busy {
  opacity: 0.5;
}

.hero-power-ring {
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.9);
  border-top-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.hero-power-bar {
  position: absolute;
  top: 28rpx;
  width: 5rpx;
  height: 22rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.9);
}

/* ---------------- 卡内底层：标题信息叠在图片上 ---------------- */

.hero-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 0 32rpx 30rpx;
}

.hero-name {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
  color: #ffffff;
  /* 极暗照片上也不糊 */
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-meta-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-meta {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.76);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-brightness {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  flex-shrink: 0;
}

.hero-meter {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.22);
  overflow: hidden;
}

.hero-meter-fill {
  height: 100%;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.92);
  transition: width 200ms ease;
}

/* ---------------- 其他设备小图 ---------------- */

.section-label {
  margin: 16rpx 8rpx 0;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 0.6rpx;
}

.thumb-scroll {
  width: 100%;
  white-space: nowrap;
}

.thumb-row {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 0 4rpx;
}

.thumb {
  flex: 0 0 auto;
  width: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.thumb-hover {
  opacity: 0.6;
}

.thumb-disc {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--card-2);
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-photo {
  width: 100%;
  height: 100%;
  display: block;
}

/* 离线的小图压暗，和大卡的语义一致 */
.thumb-disc.tone-offline,
.thumb-disc.tone-stale {
  opacity: 0.55;
}

.thumb-initial {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-2);
}

/* 已连接设备的绿点：与状态点同语义 */
.thumb-live {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  /* 缩略图上的「正在连接」点：同样压在图片/设备色块上，见上方 .hero-dot 的注释。 */
  background: #4dd17a;
  border: 4rpx solid var(--card);
  box-sizing: border-box;
}

.thumb-name {
  font-size: 22rpx;
  color: var(--text-2);
  max-width: 132rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* ---------------- 演示模式提示 ---------------- */

.demo-note {
  margin-top: auto;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--accent-soft);
  font-size: 21rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* ---------------- 卡内右上角动作组 ---------------- */

.hero-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 封面按钮：与电源键同一套玻璃质感，但更小、只是文字 */
.hero-cover-btn {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.34);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-cover-hover {
  opacity: 0.7;
}

.hero-cover-btn.busy {
  opacity: 0.45;
}

.hero-cover-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.94);
  white-space: nowrap;
}
