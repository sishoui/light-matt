/*
 * 首页：方形大卡（图片铺满 + 信息叠底）+ 其他设备小图。
 *
 * 卡片是 1:1 的接近满宽方块，占据首屏大半。图片用 absolute 铺满，
 * 信息层用 flex 压到底部，中间留空——这样换成真实照片时布局不变。
 *
 * 文字可读性靠两层保证：
 *  1. `.hero-scrim` 的纵向渐变（图底部压暗）；
 *  2. 文字自身的轻微投影（极暗照片上也不糊）。
 */

.page {
  padding-top: 0;
  /* 自定义 tabBar 是 fixed 的，内容必须自己让出它的高度。 */
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
}

/* ---------------- 空态 ---------------- */

.empty-card {
  margin-top: var(--sp-8);
  padding: var(--sp-10) var(--sp-8);
  border-radius: var(--radius-xl);
  background: var(--card);
  box-shadow: var(--shadow-raised);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-4);
}

.empty-card-hover {
  background: var(--card-press);
}

.empty-glyph {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sp-3);
}

.empty-glyph-ring {
  width: 104rpx;
  height: 104rpx;
  border: 6rpx solid var(--border);
  border-radius: 50%;
  box-sizing: border-box;
}

.empty-glyph-dot {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--text-3);
}

.empty-title {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text);
}

.empty-hint {
  font-size: var(--fs-sm);
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
  max-width: 460rpx;
}

.empty-cta {
  margin-top: var(--sp-4);
  padding: var(--sp-4) var(--sp-9);
  border-radius: var(--radius-pill);
  background: var(--accent);
  color: var(--accent-ink);
  font-size: var(--fs-body);
  font-weight: 600;
}

/* ---------------- 方形大卡 ---------------- */

.hero-card {
  position: relative;
  /* 1:1 方形：宽度撑满（页面左右各 32rpx 内边距），高度由 aspect-ratio 决定。
   * 兼容写法：先用 padding-top: 100% 撑高（老基础库不支持 aspect-ratio）。 */
  width: 100%;
  height: 0;
  padding-top: 100%;
  margin-top: var(--sp-2);
  border-radius: var(--radius-xl);
  overflow: hidden;
  /* 大卡是页面唯一的「主角」，只有它和浮动层带投影；其余卡片靠描边。
   * 描边压在图片上会让深色封面出现一圈灰边，所以这里用内阴影代替。 */
  box-shadow: var(--shadow-card), inset 0 0 0 1rpx var(--border);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

/* 按压时回收一点投影，卡片像被按下去（呼应 scale 缩小）。 */
.hero-card-hover {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(22, 32, 46, 0.06), inset 0 0 0 1rpx var(--border);
}

/* 封面图：绝对定位铺满整个方形 */
.hero-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 没有照片时的兜底：用设备色 + 亮度画渐变（和状态一致，不假装是照片）。 */
.hero-photo-fallback {
  background:
    radial-gradient(120% 100% at 62% 28%, var(--accent-soft), transparent 72%),
    var(--card);
}

/* 压暗层：底部最暗，保证标题在亮照片上也读得清 */
.hero-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.28) 0%,
    rgba(0, 0, 0, 0.04) 26%,
    rgba(0, 0, 0, 0.16) 58%,
    rgba(0, 0, 0, 0.62) 100%
  );
  pointer-events: none;
}

/* 关灯 / 离线：整卡压暗，避免「明明没开却亮着」的错觉 */
.hero-card.tone-off .hero-photo,
.hero-card.tone-offline .hero-photo,
.hero-card.tone-stale .hero-photo {
  filter: grayscale(0.55) brightness(0.62);
}

/* ---------------- 卡内上层：状态 + 电源 ---------------- */

.hero-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-6);
  padding: var(--sp-7) var(--sp-7) 0;
}

.hero-status {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-5);
  border-radius: var(--radius-pill);
  /* 半透明底：在照片上也读得清 */
  background: rgba(0, 0, 0, 0.32);
}

.hero-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}

/*
 * 大卡上的状态点是**压在图片/压暗层之上**的固定亮色，不跟随主题：
 * 这里的两处 hex 是有意保留的（背景恒定偏暗，浅色主题变量会看不清）。
 * 取值与雾蓝主题同族——关灯态用浅雾蓝而不是旧的暖橙。
 */
.tone-on .hero-dot {
  background: #7fd39a;
}

.tone-off .hero-dot {
  background: #a8c0d8;
}

.hero-status-text {
  font-size: var(--fs-caption);
  /* 固定用白色：这里压在图片上，主题变量不适用 */
  color: rgba(255, 255, 255, 0.94);
}

/* 电源键：半透明玻璃质感，压在照片上 */
.hero-power {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.34);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 160ms ease;
}

.hero-power.on {
  background: rgba(107, 140, 174, 0.94);
  border-color: rgba(255, 255, 255, 0.4);
}

.hero-power-hover {
  opacity: 0.75;
}

.hero-power.busy {
  opacity: 0.5;
}

.hero-power-ring {
  width: 40rpx;
  height: 40rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.9);
  border-top-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.hero-power-bar {
  position: absolute;
  top: 28rpx;
  width: 5rpx;
  height: 22rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.9);
}

/* ---------------- 卡内底层：标题信息叠在图片上 ---------------- */

.hero-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  padding: 0 var(--sp-7) var(--sp-7);
}

.hero-name {
  font-size: var(--fs-display);
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
  color: #ffffff;
  /* 极暗照片上也不糊 */
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-meta-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-4);
}

.hero-meta {
  font-size: var(--fs-caption);
  color: rgba(255, 255, 255, 0.76);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-brightness {
  font-size: var(--fs-body);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  flex-shrink: 0;
}

/*
 * 大卡上的亮度滑条（#93）：压在图片上，所以滑轨与文字都用白色系——
 * 主题变量在这里会看不清（照片亮度不可控）。激活色仍由页面数据传入
 * （原生 slider 读不到 CSS 变量）。
 */
.hero-slider {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  padding: var(--sp-1) 0;
}

.hero-slider-control {
  margin: 0 calc(var(--sp-4) * -1);
}

.hero-slider-control.disabled {
  opacity: 0.45;
}

.hero-slider-hint {
  font-size: var(--fs-micro);
  color: rgba(255, 255, 255, 0.7);
}

/* 电源键的就地反馈（#91）：压在图片上，固定用白色系文字。 */
.hero-power-hint {
  font-size: var(--fs-caption);
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.5;
}

/* ---------------- 其他设备小图 ---------------- */

.section-label {
  margin: var(--sp-4) var(--sp-2) 0;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 0.6rpx;
}

.thumb-scroll {
  width: 100%;
  white-space: nowrap;
}

.thumb-row {
  display: flex;
  gap: var(--sp-6);
  padding: var(--sp-2) 0 var(--sp-1);
}

.thumb {
  flex: 0 0 auto;
  width: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-3);
}

.thumb-hover {
  opacity: 0.6;
}

.thumb-disc {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--card-2);
  box-shadow: var(--shadow-raised);
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-photo {
  width: 100%;
  height: 100%;
  display: block;
}

/* 离线的小图压暗，和大卡的语义一致 */
.thumb-disc.tone-offline,
.thumb-disc.tone-stale {
  opacity: 0.55;
}

.thumb-initial {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--text-2);
}

/* 已连接设备的绿点：与状态点同语义 */
.thumb-live {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  /* 缩略图上的「正在连接」点：同样压在图片/设备色块上，见上方 .hero-dot 的注释。 */
  background: #4dd17a;
  border: 4rpx solid var(--card);
  box-sizing: border-box;
}

.thumb-name {
  font-size: var(--fs-caption);
  color: var(--text-2);
  max-width: 132rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* ---------------- 演示模式提示 ---------------- */

.demo-note {
  margin-top: auto;
  padding: var(--sp-5) var(--sp-6);
  border-radius: var(--radius-md);
  background: var(--accent-soft);
  font-size: var(--fs-caption);
  color: var(--text-2);
  line-height: 1.6;
}

/* ---------------- 卡内右上角动作组 ---------------- */

.hero-actions {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  flex-shrink: 0;
}


/* ---------------- 搜索框（#93） ---------------- */

.searchbar {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  height: 72rpx;
  padding: 0 var(--sp-5);
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--card-2);
  border: 1rpx solid var(--border);
}

.search-glyph {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.search-glyph-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid var(--text-3);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-glyph-handle {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--text-3);
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: var(--fs-body);
  color: var(--text);
}

.search-placeholder {
  color: var(--text-3);
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--card-press);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-hover {
  opacity: 0.7;
}

.search-clear-x {
  position: relative;
  width: 18rpx;
  height: 18rpx;
}

.search-clear-x::before,
.search-clear-x::after {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 18rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: var(--text-2);
}

.search-clear-x::before {
  transform: rotate(45deg);
}

.search-clear-x::after {
  transform: rotate(-45deg);
}

/* ---------------- 搜索结果（一列设备卡） ---------------- */

.search-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.search-row {
  display: flex;
  align-items: center;
  gap: var(--sp-5);
  padding: var(--sp-4);
  border-radius: var(--radius-md);
  background: var(--card);
  border: 1rpx solid var(--border);
}

.search-row-hover {
  background: var(--card-press);
}

.search-row.selected {
  border-color: var(--accent);
}

.search-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--card-2);
}

.search-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-initial {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--text);
}

.search-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.search-row-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-row-meta {
  font-size: var(--fs-caption);
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-3);
  border-right: 3rpx solid var(--text-3);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.search-empty {
  align-items: center;
}

/* ---------------- 右上角「+」下拉菜单（#93） ---------------- */

.plus-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 85;
  background: rgba(0, 0, 0, 0.18);
}

.plus-panel {
  position: fixed;
  right: 24rpx;
  z-index: 86;
  min-width: 300rpx;
  padding: var(--sp-2) 0;
  border-radius: var(--radius-lg);
  background: var(--bg-elevated);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-6);
  padding: var(--sp-5) var(--sp-7);
}

.menu-item-hover {
  background: var(--card-press);
}

.menu-item-label {
  font-size: var(--fs-body);
  color: var(--text);
}

.menu-item-sub {
  font-size: var(--fs-micro);
  color: var(--text-3);
}

/* ---------------- 长按菜单（底部弹层，#93） ---------------- */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 118;
  background: rgba(0, 0, 0, 0.42);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  background: var(--bg-elevated);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--sp-4) var(--sp-7) calc(var(--sp-7) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  box-sizing: border-box;
  animation: home-sheet-rise 180ms ease-out;
}

@keyframes home-sheet-rise {
  from {
    transform: translateY(24rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--card-press);
  align-self: center;
  margin: var(--sp-1) 0 var(--sp-3);
}

.sheet-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-6);
  padding: var(--sp-6) var(--sp-2);
  border-bottom: 1rpx solid var(--divider);
}

.sheet-item:last-of-type {
  border-bottom: none;
}

.sheet-item-hover {
  background: var(--card-press);
}

.sheet-item.disabled {
  opacity: 0.4;
}

.sheet-item-label {
  font-size: var(--fs-h3);
  color: var(--text);
}

.sheet-item-sub {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.sheet-item.disabled .sheet-item-label {
  color: var(--text-3);
}

.sheet-item.danger .sheet-item-label {
  color: var(--danger);
}

.sheet-cancel {
  margin-top: var(--sp-3);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--card-2);
  font-size: var(--fs-body);
  color: var(--text-2);
}
