<view class="page">
  <!-- 1. 顶部连接状态条：始终可见，整条可点 -->
  <view class="statusbar {{linkClass}}" bindtap="onStatusTap">
    <view class="status-dot"></view>
    <view class="status-main">
      <text class="status-text">{{statusText}}</text>
      <text class="status-sub" wx:if="{{statusSub}}">{{statusSub}}</text>
    </view>
    <text class="status-action">{{statusAction}}</text>
  </view>

  <!-- 2. 大开关 -->
  <view class="power-card">
    <view
      class="power-btn {{power ? 'on' : ''}} {{!ready ? 'disabled' : ''}} {{powerBusy ? 'busy' : ''}}"
      bindtap="onTogglePower"
    >
      <view class="power-glyph"></view>
    </view>
    <text class="power-label">{{powerLabel}}</text>
  </view>

  <!-- 3. 亮度：真实滑块（#9）。min/max 来自设备 State，不硬编码 255 -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">亮度</text>
      <text class="section-value">{{brightnessDisplay}} / {{maxBrightness}} · {{brightnessPercent}}%</text>
    </view>
    <slider
      class="brightness-slider"
      min="0"
      max="{{maxBrightness}}"
      step="1"
      value="{{brightness}}"
      disabled="{{!ready}}"
      activeColor="#ffb478"
      backgroundColor="#2a2a32"
      block-size="24"
      bindchanging="onBrightnessChanging"
      bindchange="onBrightnessChange"
    />
    <text class="section-hint">{{brightnessHintText}}</text>
  </view>

  <!-- 4. 分段（#25）：一条灯带切成最多 8 个灯珠区间，每段一个静态颜色。
       未覆盖的灯珠必须熄灭（固件 memset 保证）；这里的重叠预检只是即时反馈，
       真正的拒绝是设备回 InvalidParam。 -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">分段</text>
      <text class="section-value">{{segmentRows.length}} / {{segmentMaxCount}} 段</text>
    </view>

    <view class="seg-list">
      <view
        wx:for="{{segmentRows}}"
        wx:key="segId"
        class="seg-row {{item.selected ? 'selected' : ''}}"
        data-seg-id="{{item.segId}}"
        bindtap="onSegmentTap"
      >
        <view class="seg-swatch" style="background: {{item.hex}}"></view>
        <text class="seg-index">段 {{item.segId}}</text>
        <view class="seg-main">
          <text class="seg-range">{{item.rangeText}}</text>
          <text wx:if="{{item.paramText}}" class="seg-param">{{item.paramText}}</text>
        </view>
        <text class="seg-tag {{item.animated ? 'anim' : ''}}">{{item.typeText}}</text>
        <text
          class="seg-delete"
          data-seg-id="{{item.segId}}"
          catchtap="onSegmentDelete"
        >删除</text>
      </view>
      <view wx:if="{{segmentRows.length === 0}}" class="seg-empty">
        还没有段。输入起点与终点后点「新建区间」；未覆盖的灯珠保持熄灭。
      </view>
    </view>

    <view class="range-row">
      <input
        class="range-input"
        type="number"
        value="{{rangeStartInput}}"
        maxlength="2"
        placeholder="起点"
        disabled="{{!ready || segmentBusy}}"
        bindinput="onRangeStartInput"
      />
      <text class="range-dash">–</text>
      <input
        class="range-input"
        type="number"
        value="{{rangeEndInput}}"
        maxlength="2"
        placeholder="终点"
        disabled="{{!ready || segmentBusy}}"
        bindinput="onRangeEndInput"
      />
      <button
        class="range-apply {{segmentBusy ? 'busy' : ''}}"
        disabled="{{!ready || segmentBusy}}"
        bindtap="onApplyRange"
      >
        {{segmentBusy ? '下发中…' : '新建区间'}}
      </button>
    </view>
    <text class="section-hint">{{segmentHintText || '区间是闭区间，例如 0 – 15；选了某段后再划区间会改它的范围'}}</text>
  </view>

  <!-- 5. 灯效模式（#30 / #31）：新段下发成静态 / 呼吸 / 彩虹 / 流光。
       动画参数是绝对值：滑块松手 / 点波形 / 点方向才发 SetSegment，
       选中动画段时这些值从设备回报的段配置回填。 -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">灯效</text>
      <text class="section-value">{{segmentMode === 'breathing' ? '呼吸' : (segmentMode === 'rainbow' ? '彩虹' : (segmentMode === 'comet' ? '流光' : '静态单色'))}}</text>
    </view>

    <view class="mode-row">
      <view
        wx:for="{{segmentModeOptions}}"
        wx:key="mode"
        class="mode-chip {{segmentMode === item.mode ? 'selected' : ''}}"
        data-mode="{{item.mode}}"
        bindtap="onSegmentModeTap"
      >{{item.name}}</view>
    </view>

    <view wx:if="{{breathingVisible}}" class="breath-params">
      <view class="breath-row">
        <text class="breath-label">周期</text>
        <slider
          class="breath-slider"
          min="0"
          max="{{breathingMaxPeriod}}"
          step="10"
          value="{{breathingPeriod}}"
          disabled="{{!ready || breathingBusy}}"
          activeColor="#4f8cff"
          backgroundColor="#2a2a32"
          block-size="20"
          bindchanging="onBreathingPeriodChanging"
          bindchange="onBreathingPeriodChange"
        />
        <text class="breath-value">{{breathingPeriodText}}</text>
      </view>
      <text class="section-hint">周期 0 = 静止；最短 {{breathingMinPeriod}}ms（约 3Hz，超过会被设备拒绝）</text>

      <view class="breath-row">
        <text class="breath-label">最暗</text>
        <slider
          class="breath-slider"
          min="0"
          max="255"
          step="1"
          value="{{breathingMinLevel}}"
          disabled="{{!ready || breathingBusy}}"
          activeColor="#4f8cff"
          backgroundColor="#2a2a32"
          block-size="20"
          bindchanging="onBreathingMinLevelChanging"
          bindchange="onBreathingMinLevelChange"
        />
        <text class="breath-value">{{breathingMinLevelText}}</text>
      </view>
      <text class="section-hint">最暗 0% 能暗到全黑；越大越不明显，接近 100% 几乎不呼吸</text>

      <view class="wave-row">
        <view
          wx:for="{{waveformOptions}}"
          wx:key="value"
          class="wave-chip {{breathingWaveform === item.value ? 'selected' : ''}}"
          data-value="{{item.value}}"
          bindtap="onBreathingWaveformTap"
        >{{item.name}}</view>
      </view>

      <button
        class="range-apply {{breathingBusy ? 'busy' : ''}}"
        disabled="{{!ready || breathingBusy}}"
        bindtap="applyBreathing"
      >
        {{breathingBusy ? '下发中…' : '应用到选中段'}}
      </button>
      <text class="section-hint">{{breathingHintText || '呼吸在该段的 hue+sat 基色上脉冲；参数改动需点「应用到选中段」'}}</text>
    </view>

    <!-- 彩虹 / 流光参数（#31）。p5 字段按类型解释：彩虹 = span、流光 = tail；
         两者共用周期与方向。周期下限 200ms（5Hz，比呼吸的 334 宽松）。 -->
    <view wx:if="{{animVisible}}" class="breath-params">
      <view class="breath-row">
        <text class="breath-label">周期</text>
        <slider
          class="breath-slider"
          min="0"
          max="{{animMaxPeriod}}"
          step="10"
          value="{{animPeriod}}"
          disabled="{{!ready || animBusy}}"
          activeColor="#4f8cff"
          backgroundColor="#2a2a32"
          block-size="20"
          bindchanging="onAnimPeriodChanging"
          bindchange="onAnimPeriodChange"
        />
        <text class="breath-value">{{animPeriodText}}</text>
      </view>
      <text class="section-hint">周期 0 = 静止；最短 {{animMinPeriod}}ms（5Hz）</text>

      <view wx:if="{{segmentMode === 'rainbow'}}" class="breath-row">
        <text class="breath-label">跨度</text>
        <slider
          class="breath-slider"
          min="0"
          max="255"
          step="1"
          value="{{animSpan}}"
          disabled="{{!ready || animBusy}}"
          activeColor="#4f8cff"
          backgroundColor="#2a2a32"
          block-size="20"
          bindchanging="onAnimSpanChanging"
          bindchange="onAnimSpanChange"
        />
        <text class="breath-value">{{animSpanText}}</text>
      </view>
      <text wx:if="{{segmentMode === 'rainbow'}}" class="section-hint">跨度 0 = 整条同色；255 = 沿灯带铺满一整圈</text>

      <view wx:if="{{segmentMode === 'comet'}}" class="breath-row">
        <text class="breath-label">拖尾</text>
        <slider
          class="breath-slider"
          min="0"
          max="255"
          step="1"
          value="{{animTail}}"
          disabled="{{!ready || animBusy}}"
          activeColor="#4f8cff"
          backgroundColor="#2a2a32"
          block-size="20"
          bindchanging="onAnimTailChanging"
          bindchange="onAnimTailChange"
        />
        <text class="breath-value">{{animTailText}}</text>
      </view>
      <text wx:if="{{segmentMode === 'comet'}}" class="section-hint">拖尾 0 = 硬边亮点；越大越是长拖尾</text>

      <view class="wave-row">
        <view
          class="wave-chip {{!animReverse ? 'selected' : ''}}"
          data-value="0"
          bindtap="onAnimReverseTap"
        >正向</view>
        <view
          class="wave-chip {{animReverse ? 'selected' : ''}}"
          data-value="1"
          bindtap="onAnimReverseTap"
        >反向</view>
      </view>

      <button
        class="range-apply {{animBusy ? 'busy' : ''}}"
        disabled="{{!ready || animBusy}}"
        bindtap="applyAnimation"
      >
        {{animBusy ? '下发中…' : '应用到选中段'}}
      </button>
      <text class="section-hint">{{animHintText || '基准色取色环当前颜色；参数改动需点「应用到选中段」'}}</text>
    </view>
  </view>

  <!-- 5. 颜色：色相环（单块 canvas）+ 饱和度。V 恒为 1，亮度由上面的滑块负责。
       #25 起写入**选中段**的静态颜色；没有选中段时手势被忽略并提示。 -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">颜色</text>
      <view class="color-readout">
        <view class="swatch" style="background: {{colorHex}}"></view>
        <text class="section-value mono">{{colorHex}}</text>
      </view>
    </view>

    <view class="wheel-wrap">
      <canvas
        type="2d"
        id="color-wheel"
        class="wheel-canvas"
        bindtouchstart="onWheelTouchStart"
        bindtouchmove="onWheelTouchMove"
        bindtouchend="onWheelTouchEnd"
        bindtouchcancel="onWheelTouchEnd"
      ></canvas>
    </view>

    <view class="sat-row">
      <text class="sat-label">饱和度</text>
      <slider
        class="sat-slider"
        min="0"
        max="100"
        step="1"
        value="{{colorSaturation}}"
        disabled="{{!ready}}"
        activeColor="{{colorHex}}"
        backgroundColor="#2a2a32"
        block-size="20"
        bindchanging="onSaturationChanging"
        bindchange="onSaturationChange"
      />
      <text class="sat-value">{{colorSaturation}}%</text>
    </view>

    <text class="section-hint">{{colorHintText}}</text>
  </view>

  <!-- 6. 预设：点击后把**选中段**改成该颜色（SetSegment 0x10），等 ACK -->
  <view class="presets {{ready ? '' : 'disabled'}}">
    <view
      wx:for="{{presetList}}"
      wx:key="name"
      class="preset {{selectedPreset === item.name ? 'selected' : ''}}"
      data-index="{{index}}"
      bindtap="onPresetTap"
    >
      <view class="preset-dot" style="background: {{item.hex}}"></view>
      <text class="preset-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 7. 页脚：版本 + 提示；版本号连点 5 次开启隐藏日志面板 -->
  <view class="footer">
    <text class="version" bindtap="onVersionTap">v{{version}}</text>
    <text class="footer-hint">开关与设备状态以设备为准</text>
  </view>

  <!-- 7. 扫描 / 设备弹层 -->
  <view wx:if="{{sheetVisible}}" class="sheet-mask" bindtap="onSheetMaskTap">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{sheetMode === 'scan' ? '选择设备' : '设备'}}</text>
        <text class="sheet-close" bindtap="closeSheet">关闭</text>
      </view>

      <block wx:if="{{sheetMode === 'scan'}}">
        <!-- #33：「最近连过」来自本地缓存，后端不可达时照样能渲染与连接 -->
        <view wx:if="{{recentDevices.length > 0}}" class="device-section-title">最近连过</view>
        <scroll-view wx:if="{{recentDevices.length > 0}}" scroll-y class="device-list recent-list">
          <view
            wx:for="{{recentDevices}}"
            wx:key="deviceId"
            class="device-row"
            data-device-id="{{item.deviceId}}"
            data-name="{{item.name}}"
            bindtap="onDeviceTap"
          >
            <text class="device-name">{{item.name || item.deviceId}}</text>
            <text class="device-meta">{{item.deviceId}}</text>
          </view>
        </scroll-view>

        <view class="device-section-title">附近可用</view>
        <scroll-view scroll-y class="device-list">
          <view
            wx:for="{{devices}}"
            wx:key="deviceId"
            class="device-row"
            data-device-id="{{item.deviceId}}"
            data-name="{{item.name}}"
            bindtap="onDeviceTap"
          >
            <text class="device-name">{{item.name}}</text>
            <text class="device-meta">{{item.deviceId}} · {{item.rssi}} dBm</text>
          </view>
          <view wx:if="{{devices.length === 0}}" class="device-empty">
            {{scanHint || '扫描中…'}}
          </view>
        </scroll-view>
        <view wx:if="{{scanHint && devices.length > 0}}" class="scan-hint">{{scanHint}}</view>
        <button class="sheet-btn" bindtap="onRescan" disabled="{{switchBusy}}">
          {{switchBusy ? '正在切换…' : '重新扫描'}}
        </button>
      </block>

      <block wx:else>
        <view class="device-info">
          <view class="info-row">
            <text class="info-label">设备</text>
            <text class="info-value">{{deviceName || '未知'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">deviceId</text>
            <text class="info-value mono">{{deviceId}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">开关</text>
            <text class="info-value">{{power ? '开' : '关'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">亮度</text>
            <text class="info-value">{{brightness}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">协议版本</text>
            <text class="info-value">v2</text>
          </view>
        </view>
        <!-- 自检放在设备弹层里，不占主控制流（#13） -->
        <button
          class="sheet-btn ghost"
          bindtap="onSelfTest"
          disabled="{{!ready || selfTestBusy}}"
        >
          {{selfTestBusy ? '自检中…' : '自检（红→绿→蓝→白）'}}
        </button>

        <!-- 灯珠数量（#12）：设备级低频设置，只在设备弹层里改 -->
        <view class="led-count-block">
          <view class="led-count-head">
            <text class="info-label">灯珠数量</text>
            <text class="led-count-current">当前 {{ledCount > 0 ? ledCount : '—'}} 颗</text>
          </view>
          <view class="led-count-row">
            <input
              class="led-count-input"
              type="number"
              value="{{ledCountInput}}"
              maxlength="2"
              placeholder="1-64"
              disabled="{{!ready || ledCountBusy}}"
              bindinput="onLedCountInput"
            />
            <button
              class="led-count-apply {{ledCountBusy ? 'busy' : ''}}"
              disabled="{{!ready || ledCountBusy}}"
              bindtap="onApplyLedCount"
            >
              {{ledCountBusy ? '应用中…' : '应用'}}
            </button>
          </view>
          <text class="led-count-hint {{ledCountHintText ? 'visible' : ''}}">
            {{ledCountHintText || '改完立即生效并写入设备，重启后保持；非法值会被拒绝'}}
          </text>
        </view>

        <button class="sheet-btn ghost danger" bindtap="onDisconnect">断开连接</button>
      </block>
    </view>
  </view>

  <!-- 8. 隐藏协议日志面板（#13）：连点版本号 5 次开启；数据源是 FrameLog（200 帧） -->
  <view wx:if="{{logVisible}}" class="log-mask" bindtap="onLogCloseTap">
    <view class="log-panel" catchtap="noop">
      <view class="log-head">
        <text class="log-title">
          协议日志 · {{logCount}} 帧{{logPaused ? ' · 视图已暂停' : ''}}
        </text>
        <text class="log-close" bindtap="onLogCloseTap">关闭</text>
      </view>
      <view class="log-toolbar">
        <view class="log-btn" bindtap="onLogPauseTap">{{logPaused ? '继续' : '暂停'}}</view>
        <view class="log-btn" bindtap="onLogClearTap">清空</view>
        <view class="log-btn" bindtap="onLogCopyTap">复制</view>
      </view>
      <text wx:if="{{logHint}}" class="log-hint">{{logHint}}</text>
      <scroll-view
        scroll-y
        class="log-list"
        scroll-into-view="{{logScrollTarget}}"
        scroll-with-animation="{{false}}"
      >
        <view
          wx:for="{{logRows}}"
          wx:key="id"
          id="log-row-{{item.id}}"
          class="log-row {{item.dir}} {{item.ok ? '' : 'bad'}}"
        >
          <text class="log-time">{{item.time}}</text>
          <text class="log-arrow">{{item.arrow}}</text>
          <text class="log-hex">{{item.hex}}</text>
          <text class="log-name">{{item.name}}{{item.seq === '-' ? '' : ' seq=' + item.seq}}</text>
          <text class="log-parsed">{{item.parsed}}</text>
        </view>
        <view wx:if="{{logRows.length === 0}}" class="log-empty">
          还没有帧。连接设备并操作后，这里会显示收发记录。
        </view>
      </scroll-view>
      <text class="log-foot">
        与固件串口按 seq 对齐；开发版 console 打印的是同一份数据
      </text>
    </view>
  </view>
</view>
