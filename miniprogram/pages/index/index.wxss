.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #101014;
  color: #f5f5f5;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.status {
  font-size: 28rpx;
  color: #8fd18f;
}

.meta {
  font-size: 24rpx;
  color: #9a9aa5;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.devices {
  height: 260rpx;
  border: 1rpx solid #2a2a32;
  border-radius: 12rpx;
  padding: 8rpx;
}

.device {
  padding: 10rpx 8rpx;
  border-bottom: 1rpx solid #22222a;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.device-name {
  font-size: 28rpx;
}

.device-meta {
  font-size: 22rpx;
  color: #9a9aa5;
}

.empty {
  padding: 24rpx 8rpx;
  font-size: 24rpx;
  color: #6f6f7a;
}

.logs {
  flex: 1;
  min-height: 360rpx;
  border: 1rpx solid #2a2a32;
  border-radius: 12rpx;
  padding: 8rpx;
}

.log {
  display: block;
  font-size: 20rpx;
  line-height: 1.5;
  color: #c9c9d1;
  font-family: monospace;
  word-break: break-all;
}
