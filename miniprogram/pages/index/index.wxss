.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #101014;
  color: #f5f5f5;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ---------------- 连接状态条 ---------------- */

.statusbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #18181e;
  border: 1rpx solid #2a2a32;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #6f6f7a;
  flex-shrink: 0;
}

.link-ready .status-dot {
  background: #4dd17a;
}

.link-busy .status-dot {
  background: #ffb478;
}

.link-warn .status-dot {
  background: #ffb478;
}

.link-error .status-dot {
  background: #ff6b6b;
}

.status-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.status-text {
  font-size: 30rpx;
  font-weight: 600;
}

.status-sub {
  font-size: 22rpx;
  color: #9a9aa5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-action {
  font-size: 24rpx;
  color: #ffb478;
  flex-shrink: 0;
}

/* ---------------- 大开关 ---------------- */

.power-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 0 16rpx;
}

.power-btn {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: #1c1c23;
  border: 2rpx solid #2f2f38;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 120ms ease;
}

.power-btn.on {
  background: #2a2118;
  border-color: #ffb478;
  box-shadow: 0 0 48rpx rgba(255, 180, 120, 0.35);
}

.power-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.power-btn.busy {
  opacity: 0.7;
  pointer-events: none;
}

/* 电源图标：圆环 + 竖线，纯 CSS，不引入图标资源 */
.power-glyph {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border: 8rpx solid #c9c9d1;
  border-radius: 50%;
  border-top-color: transparent;
}

.power-btn.on .power-glyph {
  border-color: #ffb478;
  border-top-color: transparent;
}

.power-glyph::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -12rpx;
  width: 8rpx;
  height: 48rpx;
  margin-left: -4rpx;
  background: #c9c9d1;
  border-radius: 4rpx;
}

.power-btn.on .power-glyph::after {
  background: #ffb478;
}

.power-label {
  font-size: 26rpx;
  color: #9a9aa5;
}

/* ---------------- 预留区块（亮度 / 颜色 / 预设） ---------------- */

.section {
  background: #18181e;
  border: 1rpx solid #2a2a32;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section.disabled,
.presets.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
}

.section-value {
  font-size: 26rpx;
  color: #9a9aa5;
  font-family: Menlo, Consolas, monospace;
}

.section-hint {
  font-size: 22rpx;
  color: #6f6f7a;
}

.swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  border: 1rpx solid #3a3a44;
}

/* 亮度滑块（原生 slider，样式只覆盖高度与间距） */
.brightness-slider {
  margin: 8rpx 0;
}

/* 色环：单块 canvas，色相环 + 选中点都画在同一层（拖动时局部擦补） */
.wheel-wrap {
  position: relative;
  align-self: center;
  width: 420rpx;
  height: 420rpx;
}

.wheel-canvas {
  width: 100%;
  height: 100%;
}

/* 颜色读数：色块 + hex */
.color-readout {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 饱和度滑块行 */
.sat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sat-label {
  font-size: 24rpx;
  color: #9a9aa5;
  flex-shrink: 0;
}

.sat-slider {
  flex: 1;
  margin: 0;
}

.sat-value {
  font-size: 24rpx;
  color: #9a9aa5;
  font-family: Menlo, Consolas, monospace;
  width: 72rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 预设：6-8 个色块，等宽分布；选中用外环而不是改颜色 */
.presets {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12rpx 0;
  padding: 20rpx;
  background: #18181e;
  border: 1rpx solid #2a2a32;
  border-radius: 20rpx;
}

.preset {
  width: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 0;
  border-radius: 16rpx;
}

.preset-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #3a3a44;
  box-sizing: border-box;
}

/* 选中态：白色外环 + 留白，不动色块本身的颜色 */
.preset.selected .preset-dot {
  box-shadow: 0 0 0 4rpx #101014, 0 0 0 8rpx #f5f5f5;
}

.preset-name {
  font-size: 20rpx;
  color: #9a9aa5;
}

.preset.selected .preset-name {
  color: #f5f5f5;
}

/* ---------------- 分段编辑器（#25） ---------------- */

.seg-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.seg-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #101014;
  border: 1rpx solid #2a2a32;
}

/* 选中态：只改边框，不动色块本身 */
.seg-row.selected {
  border-color: #ffb478;
  background: #1c1a17;
}

.seg-swatch {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 1rpx solid #3a3a44;
  flex-shrink: 0;
}

.seg-index {
  font-size: 24rpx;
  color: #f5f5f5;
  flex-shrink: 0;
}

.seg-range {
  font-size: 24rpx;
  color: #9a9aa5;
  font-family: Menlo, Consolas, monospace;
  flex: 1;
}

.seg-tag {
  font-size: 20rpx;
  color: #9a9aa5;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #23232b;
}

.seg-delete {
  font-size: 22rpx;
  color: #ff8a8a;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.seg-empty {
  padding: 24rpx 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6f6f7a;
}

.range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.range-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #101014;
  border: 1rpx solid #2a2a32;
  color: #f5f5f5;
  font-size: 26rpx;
  text-align: center;
}

.range-dash {
  color: #6f6f7a;
  flex-shrink: 0;
}

.range-apply {
  flex-shrink: 0;
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #ffb478;
  color: #1a1208;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.range-apply.busy {
  opacity: 0.6;
}

/* ---------------- 页脚 ---------------- */

.footer {
  margin-top: auto;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.version {
  font-size: 22rpx;
  color: #6f6f7a;
  font-family: Menlo, Consolas, monospace;
}

.footer-hint {
  font-size: 22rpx;
  color: #6f6f7a;
}

/* ---------------- 扫描 / 设备弹层 ---------------- */

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 70vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #18181e;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 26rpx;
  color: #9a9aa5;
}

.device-list {
  height: 420rpx;
  border: 1rpx solid #2a2a32;
  border-radius: 16rpx;
}

/* #33：最近连过区更矮，把空间留给实时扫描结果。 */
.recent-list {
  height: 240rpx;
}

.device-section-title {
  margin: 16rpx 0 8rpx;
  font-size: 24rpx;
  color: #9a9aa5;
}

.device-row {
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #22222a;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.device-name {
  font-size: 28rpx;
}

.device-meta {
  font-size: 22rpx;
  color: #9a9aa5;
  font-family: Menlo, Consolas, monospace;
}

.device-empty {
  padding: 32rpx 16rpx;
  font-size: 24rpx;
  color: #6f6f7a;
  line-height: 1.6;
}

.scan-hint {
  font-size: 22rpx;
  color: #ffb478;
}

.sheet-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #ffb478;
  color: #1a1208;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.sheet-btn.ghost {
  background: #23232b;
  color: #f5f5f5;
}

.sheet-btn.danger {
  color: #ff8a8a;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 8rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 24rpx;
}

.info-label {
  color: #9a9aa5;
  flex-shrink: 0;
}

.info-value {
  color: #f5f5f5;
  word-break: break-all;
  text-align: right;
}

.mono {
  font-family: Menlo, Consolas, monospace;
}

/* ---------------- 隐藏协议日志面板（#13） ---------------- */

/* 版本号是面板的唯一入口：连点 5 次；保留一点点击热区但视觉不变 */
.version {
  padding: 8rpx 0;
}

.log-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: flex-end;
}

.log-panel {
  width: 100%;
  height: 78vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #0c0c10;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.log-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f5f5f5;
}

.log-close {
  font-size: 26rpx;
  color: #9a9aa5;
  padding: 4rpx 8rpx;
}

.log-toolbar {
  display: flex;
  gap: 12rpx;
}

.log-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #1c1c23;
  border: 1rpx solid #2f2f38;
  font-size: 24rpx;
  color: #f5f5f5;
}

.log-hint {
  font-size: 22rpx;
  color: #ffb478;
}

.log-list {
  flex: 1;
  min-height: 0;
  border: 1rpx solid #22222a;
  border-radius: 12rpx;
  background: #101014;
  padding: 8rpx;
  box-sizing: border-box;
}

.log-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  padding: 8rpx 6rpx;
  border-bottom: 1rpx solid #1c1c23;
  font-family: Menlo, Consolas, monospace;
  font-size: 20rpx;
  line-height: 1.5;
  color: #c9c9d1;
}

.log-row.tx .log-arrow {
  color: #ffb478;
}

.log-row.rx .log-arrow {
  color: #4dd17a;
}

.log-row.bad .log-parsed {
  color: #ff8a8a;
}

.log-time {
  color: #6f6f7a;
}

.log-hex {
  color: #9a9aa5;
  word-break: break-all;
}

.log-name {
  color: #f5f5f5;
}

.log-parsed {
  width: 100%;
  color: #9a9aa5;
  word-break: break-all;
}

.log-empty {
  padding: 32rpx 12rpx;
  font-size: 24rpx;
  color: #6f6f7a;
  line-height: 1.6;
}

.log-foot {
  font-size: 20rpx;
  color: #6f6f7a;
}

/* ---------------- 灯珠数量（#12，设备弹层内） ---------------- */

.led-count-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #1c1c22;
  border: 1rpx solid #2a2a32;
}

.led-count-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 24rpx;
}

.led-count-current {
  color: #ffb478;
  font-size: 24rpx;
}

.led-count-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.led-count-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #101014;
  border: 1rpx solid #2a2a32;
  color: #f5f5f5;
  font-size: 28rpx;
}

.led-count-apply {
  flex-shrink: 0;
  width: 168rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #ffb478;
  color: #1a1208;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.led-count-apply.busy {
  opacity: 0.6;
}

.led-count-hint {
  font-size: 22rpx;
  line-height: 1.5;
  color: #9a9aa5;
}

/* 有实际反馈（成功 / 拒绝原因）时提亮，避免和常驻说明混淆。 */
.led-count-hint.visible {
  color: #ffb478;
}
