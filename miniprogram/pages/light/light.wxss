/* 灯光页独有布局：灯带切换器（共享外观在 app.wxss）。 */

.strip-switcher {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.strip-switcher.disabled {
  opacity: 0.5;
}

/* 8 条带横向滚动，不换行：换行会把下面的开关挤出首屏。 */
.strip-scroll {
  width: 100%;
  white-space: nowrap;
}

.strip-chip-row {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.strip-chip {
  flex: 0 0 auto;
  min-width: 176rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #18181e;
  border: 1rpx solid #2a2a32;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.strip-chip.selected {
  border-color: #ffb478;
  background: #1c1a17;
}

/* 关着的带整体压暗，但文字仍可读（要能看见灯珠数与段数）。 */
.strip-chip.off {
  opacity: 0.6;
}

.strip-chip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.strip-chip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #f5f5f5;
}

/* 动画提示点：只作显示（协议 §9.1 明确它不能当正确性依据）。 */
.strip-anim-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4f8cff;
  flex-shrink: 0;
}

.strip-chip-sub {
  font-size: 20rpx;
  color: #9a9aa5;
  font-family: Menlo, Consolas, monospace;
  white-space: nowrap;
}

.strip-empty {
  padding: 24rpx 8rpx;
  font-size: 22rpx;
  color: #6f6f7a;
}

.strip-power-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-hint.inline {
  font-size: 20rpx;
  flex: 1;
}

.seg-head-actions {
  display: flex;
  gap: 20rpx;
}

.section-action {
  font-size: 24rpx;
  color: #ffb478;
}

.seg-edit {
  font-size: 22rpx;
  color: #9ec4ff;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}
