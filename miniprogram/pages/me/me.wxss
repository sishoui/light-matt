/* 「我的」页：本机身份 / 外观 / 演示设备 / 我的设备 / 页脚。 */

.page {
  /* 自定义 tabBar 是 fixed 的，tab 页内容必须让出它的高度。 */
  padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
}

/* ---------------- 本机身份 ---------------- */

.profile-card {
  flex-direction: row;
  align-items: center;
  gap: var(--sp-6);
}

/* 去掉 <button> 的默认外观，只留一个圆形点击区。 */
.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
  flex-shrink: 0;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
}

/* 默认头像：纯 CSS 人物剪影（上圆头 + 下圆拱肩）。 */
.avatar-fallback {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--card-2);
  border: 1rpx solid var(--border);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
}

.avatar-head {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--text-3);
}

.avatar-shoulders {
  width: 68rpx;
  height: 34rpx;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  background: var(--text-3);
}

.profile-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.nickname-input {
  height: 64rpx;
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text);
}

.profile-hint {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ---------------- 外观分段控件 ---------------- */

.segmented {
  display: flex;
  padding: var(--sp-1);
  border-radius: var(--radius-md);
  background: var(--card-2);
}

.segment {
  flex: 1;
  text-align: center;
  padding: var(--sp-4) 0;
  border-radius: var(--radius-sm);
  font-size: var(--fs-sm);
  color: var(--text-2);
  transition: background 160ms ease;
}

.segment.on {
  background: var(--card-selected);
  color: var(--text);
  font-weight: 600;
  box-shadow: var(--shadow-raised);
}

/* ---------------- 我的设备行 ---------------- */

.device-item {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid var(--divider);
}

.device-item:last-child {
  border-bottom: none;
}

.device-item .device-row {
  flex: 1;
  border-bottom: none;
  /* 左名称 / 右徽标，覆盖 app.wxss 的纵向 device-row。 */
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
}

.device-main {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  min-width: 0;
}

.device-badge {
  font-size: var(--fs-micro);
  color: var(--accent);
  padding: var(--sp-1) var(--sp-3);
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  flex: 0 0 auto;
}

.device-delete {
  flex: 0 0 auto;
  width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  color: var(--danger);
  border-left: 1rpx solid var(--divider);
}
