/*
 * 部位编辑器（v5 / #155）。
 *
 * 共享外观在 app.wxss（`.page` / `.btn` / `.section-head`），这里只放本页
 * 独有的两件事：**写入失败提示**与**表单行**。
 *
 * 颜色一律走 CSS 变量（AGENTS.md：页面 wxss 不写死 hex，否则某个主题下会
 * 白底白字）；原生 slider / switch 的激活色由页面数据 `accentColor` 传入。
 */

.content {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  padding: var(--sp-2) var(--sp-4) calc(140rpx + env(safe-area-inset-bottom));
}

/* ---------------- 写入失败提示（页面顶部） ---------------- */

.apply-error {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-3);
  padding: var(--sp-4);
  border-radius: var(--radius-md);
  background: var(--danger-soft);
}

.apply-error-text {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--danger);
  line-height: 1.5;
}

.apply-error-close {
  font-size: var(--fs-body);
  color: var(--danger);
}

/* ---------------- 离线 / 参数缺失 ---------------- */

.hint-card {
  padding: var(--sp-6);
  border-radius: var(--radius-md);
  background: var(--card);
}

.hint-text {
  font-size: var(--fs-body);
  color: var(--text-2);
}

/* ---------------- 区块标题 ---------------- */

.section-note {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ---------------- 表单 ---------------- */

.card {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-5);
  border-radius: var(--radius-lg);
  background: var(--card);
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
  min-height: 64rpx;
}

.field-label {
  font-size: var(--fs-body);
  color: var(--text-2);
}

.field-value {
  font-size: var(--fs-body);
  color: var(--text);
}

.field-input {
  flex: 1;
  text-align: right;
  font-size: var(--fs-body);
  color: var(--text);
}

.field-hint {
  font-size: var(--fs-caption);
  color: var(--text-3);
  line-height: 1.5;
}

.picker-value {
  font-size: var(--fs-body);
  color: var(--accent);
}

.primary-btn {
  margin-top: var(--sp-2);
  padding: var(--sp-4);
  border-radius: var(--radius-md);
  background: var(--accent);
  color: var(--accent-ink);
  font-size: var(--fs-body);
  text-align: center;
}

.primary-btn[disabled] {
  opacity: 0.5;
}

/* ---------------- 时间轴（#154 单元的输出） ---------------- */

.timeline-row {
  display: flex;
  gap: 8px;
  width: 100%;
}

.timeline-block {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-height: 48rpx;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  color: var(--text-2);
  overflow: hidden;
}

.timeline-block.selected {
  background: var(--accent-soft);
  color: var(--accent);
}

.timeline-label,
.timeline-order {
  font-size: var(--fs-caption);
}

.tick-row {
  position: relative;
  height: 40rpx;
}

.tick {
  position: absolute;
  font-size: var(--fs-caption);
  color: var(--text-3);
  transform: translateX(-50%);
}

/* 两端贴边：标签不越出容器（位置仍由单元的 percent 决定）。 */
.tick-first {
  transform: none;
}

.tick-last {
  transform: translateX(-100%);
}

/* ---------------- 效果面板（#154 单元的输出） ---------------- */

.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
}

.type-cell {
  flex: 1 1 22%;
  padding: var(--sp-2) 0;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  color: var(--text-2);
  font-size: var(--fs-caption);
  text-align: center;
}

.type-cell.selected {
  background: var(--accent-soft);
  color: var(--accent);
}

.slider-row {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.choice-row {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.choice-cells {
  display: flex;
  gap: var(--sp-2);
}

.choice-cell {
  flex: 1;
  padding: var(--sp-2) 0;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  color: var(--text-2);
  font-size: var(--fs-caption);
  text-align: center;
}

.choice-cell.selected {
  background: var(--accent-soft);
  color: var(--accent);
}

/* ---------------- 线视图（#156，`lineBlocks` 的输出） ---------------- */

/* 一条线表示整条链：块按比例定位，露出的底色就是灰缝。 */
.line-track {
  position: relative;
  height: 28rpx;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  overflow: hidden;
}

.line-block {
  position: absolute;
  top: 0;
  bottom: 0;
  opacity: 0.55;
}

/* 当前编辑的部位更亮；别的部位压暗，一眼能分出「我在改哪一块」。 */
.line-block.current {
  opacity: 1;
}

.line-legend {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-3);
}

/* ---------------- 方格表弹窗（#156） ---------------- */

.grid-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.grid-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  padding: var(--sp-5) var(--sp-4) calc(var(--sp-5) + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--bg-elevated);
  box-shadow: var(--shadow-overlay);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.grid-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.grid-title {
  font-size: var(--fs-h3);
  color: var(--text);
}

.grid-sub {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.grid-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  max-height: 46vh;
  overflow-y: auto;
}

.grid-row {
  display: flex;
  gap: 4rpx;
}

/* 每格一颗灯；`flex: 1` 让一行均分容器宽（列数由 `gridColumns` 决定）。 */
.grid-cell {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  border-radius: var(--radius-xs);
  background: var(--card-2);
  color: var(--text-3);
  font-size: var(--fs-micro);
  line-height: 44rpx;
  text-align: center;
  overflow: hidden;
}

/* 每十颗一段：左侧加粗分隔（U7）。 */
.grid-cell.decade-start {
  border-left: 2rpx solid var(--border-strong);
}

/* 空闲 / 自己 / 别的部位：靠色块区分（颜色由 `partColor` 从数据里带进来）。 */
.grid-cell.cell-free {
  background: var(--card-2);
  color: var(--text-3);
}

.grid-cell.cell-own,
.grid-cell.cell-other {
  color: var(--accent-ink);
}

.grid-cell.cell-other {
  opacity: 0.45;
}

/* 本次选区：高亮成主色。 */
.grid-cell.cell-candidate {
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 600;
}

/* 压到别的部位：斜纹 + 危险色（S4：整体拒绝，但选区其余部分仍可见）。 */
.grid-cell.cell-blocked {
  color: var(--danger);
  font-weight: 600;
  background-image: repeating-linear-gradient(
    45deg,
    var(--danger-soft) 0,
    var(--danger-soft) 6rpx,
    transparent 6rpx,
    transparent 12rpx
  );
}

.grid-draft {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-conflict {
  font-size: var(--fs-caption);
  color: var(--danger);
  line-height: 1.5;
}

.grid-pickers {
  display: flex;
  gap: var(--sp-3);
}

.grid-pickers picker {
  flex: 1;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) var(--sp-4);
  border-radius: var(--radius-md);
  background: var(--card-2);
}

.picker-label {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.grid-actions {
  display: flex;
  gap: var(--sp-3);
  padding-top: var(--sp-2);
}

.grid-cancel,
.grid-confirm {
  flex: 1;
  padding: var(--sp-4);
  border-radius: var(--radius-md);
  font-size: var(--fs-body);
  text-align: center;
}

.grid-cancel {
  background: var(--card-2);
  color: var(--text-2);
}

.grid-confirm {
  background: var(--accent);
  color: var(--accent-ink);
}

.grid-confirm.disabled {
  opacity: 0.5;
}
