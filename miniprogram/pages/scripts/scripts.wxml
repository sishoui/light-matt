<view class="page">
  <view class="statusbar {{linkClass}}" bindtap="onGoDevices">
    <view class="status-dot"></view>
    <view class="status-main">
      <text class="status-text">{{statusText}}</text>
      <text class="status-sub">{{statusSub}}</text>
    </view>
    <text class="status-action">{{ready ? '设备' : '去连接'}}</text>
  </view>

  <!-- 剧本（#32 迁入，#45 扩成时间轴）：多阶段序列，设备自己跑时间轴
       （手机断开后继续演）。草稿在本地；点「下发」才展开成
       Begin → Stage/Segment… → Commit → Activate。 -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">剧本</text>
      <text class="section-value">{{playbackStageText}} · {{playbackText}}</text>
    </view>

    <!-- 剧本编号：4 套槽位各自独立编辑 / 下发 / 激活 -->
    <view class="script-id-row">
      <text class="script-id-label">剧本</text>
      <view
        wx:for="{{scriptIdOptions}}"
        wx:key="*this"
        class="script-id {{scriptId === item ? 'selected' : ''}}"
        data-script-id="{{item}}"
        bindtap="onScriptIdTap"
      >{{item + 1}}</view>
      <text class="script-id-hint">{{scriptStageRows.length}} / {{scriptMaxStages}} 阶段</text>
    </view>

    <!-- 阶段时间轴：每阶段一张卡片；上移 / 下移 = 改播放顺序 -->
    <view class="script-stage-list">
      <view
        wx:for="{{scriptStageRows}}"
        wx:key="index"
        class="script-stage {{item.active ? 'selected' : ''}}"
        data-stage="{{item.index}}"
        bindtap="onScriptStageTap"
      >
        <view class="script-stage-order">
          <text
            class="stage-move {{item.first ? 'off' : ''}}"
            data-stage="{{item.index}}"
            data-delta="-1"
            catchtap="onScriptMoveStage"
          >↑</text>
          <text
            class="stage-move {{item.last ? 'off' : ''}}"
            data-stage="{{item.index}}"
            data-delta="1"
            catchtap="onScriptMoveStage"
          >↓</text>
        </view>
        <view class="script-stage-main">
          <text class="script-stage-title">{{item.title}}</text>
          <!-- 跨带预览：哪几条带、各几个段（不逐颗预览像素） -->
          <text class="script-stage-strips">{{item.stripText}}</text>
          <text class="script-stage-segments">{{item.segmentText}}</text>
        </view>
        <view class="script-stage-side">
          <input
            class="script-duration {{item.invalid ? 'invalid' : ''}}"
            type="number"
            value="{{item.duration}}"
            maxlength="5"
            data-stage="{{item.index}}"
            disabled="{{!ready || scriptBusy}}"
            bindinput="onScriptStageDurationInput"
          />
          <text class="script-duration-unit">ms</text>
          <text class="script-stage-delete" data-stage="{{item.index}}" catchtap="onScriptRemoveStage">删</text>
        </view>
      </view>
    </view>

    <!-- 当前阶段的段：可单条删除（跨带同号槽位是两个不同的段） -->
    <view wx:if="{{currentStageSegments.length > 0}}" class="stage-seg-list">
      <text class="stage-seg-title">阶段 {{scriptActiveStage + 1}} 的段</text>
      <view
        wx:for="{{currentStageSegments}}"
        wx:key="key"
        class="stage-seg-row"
      >
        <text class="stage-seg-text">带 {{item.stripId + 1}} · 段 {{item.segId}} · {{item.rangeText}}</text>
        <text class="seg-tag">{{item.typeText}}</text>
        <text wx:if="{{item.secondLayer}}" class="seg-tag layer-tag">两层</text>
        <text
          class="seg-delete"
          data-seg-id="{{item.segId}}"
          data-strip-id="{{item.stripId}}"
          catchtap="onScriptRemoveSegment"
        >删除</text>
      </view>
    </view>

    <view class="btn-row">
      <button class="btn" disabled="{{!ready || scriptBusy}}" bindtap="onScriptAddStage">加阶段</button>
      <button class="btn" disabled="{{!ready || scriptBusy}}" bindtap="onScriptAddSegment">
        当前段加入阶段
      </button>
      <button class="btn ghost" disabled="{{!ready || scriptBusy}}" bindtap="onScriptClearStageSegments">
        清空本阶段段
      </button>
    </view>
    <text class="section-hint">「当前段」= 灯光页选中的那条带的那个段；参数取设备上的值（两层一起带入）</text>

    <!-- 容量预检（§10.4）：本地就能看到会不会超 16KB -->
    <view class="capacity-row {{scriptOverCapacity ? 'over' : ''}}">
      <text class="capacity-text">
        预估持久化 {{scriptEstimatedBytes}} / {{scriptCapacityLimit}} 字节
      </text>
      <text wx:if="{{scriptOverCapacity}}" class="capacity-warn">剧本过大，请减少阶段数/段数/灯带数</text>
    </view>

    <!-- 下发进度：百分比来自每帧 ACK（0x86 只是旁证，括号里另给） -->
    <view class="script-progress" wx:if="{{scriptProgressPercent >= 0}}">
      <view class="script-progress-bar">
        <view class="script-progress-fill" style="width: {{scriptProgressPercent}}%"></view>
      </view>
      <text class="script-progress-text">
        {{scriptProgressText}}（{{scriptProgressPercent}}%<block wx:if="{{scriptDeviceFrames >= 0}}"> · 设备确认 {{scriptDeviceFrames}} 帧</block>）
      </text>
    </view>

    <view class="btn-row">
      <button class="btn primary" disabled="{{!ready || scriptBusy || scriptOverCapacity}}" bindtap="onScriptDownload">
        {{scriptBusy ? '下发中…' : '下发剧本'}}
      </button>
      <button class="btn" disabled="{{!ready || scriptBusy}}" bindtap="onScriptActivate">
        激活剧本 {{scriptId + 1}}
      </button>
    </view>

    <!-- 播放控制：暂停后「播放」从暂停点继续，不从头 -->
    <view class="playback-row">
      <button
        class="playback-btn {{playbackState === 1 ? 'active' : ''}}"
        data-action="1"
        disabled="{{!ready || playbackBusy}}"
        bindtap="onPlaybackTap"
      >播放</button>
      <button
        class="playback-btn {{playbackState === 2 ? 'active' : ''}}"
        data-action="2"
        disabled="{{!ready || playbackBusy}}"
        bindtap="onPlaybackTap"
      >暂停</button>
      <button class="playback-btn" data-action="0" disabled="{{!ready || playbackBusy}}" bindtap="onPlaybackTap">
        停止
      </button>
      <view class="playback-loop">
        <text class="playback-loop-label">循环</text>
        <switch checked="{{playbackLoop}}" color="#ffb478" disabled="{{!ready}}" bindchange="onPlaybackLoopChange" />
      </view>
    </view>

    <text class="section-hint">{{scriptHintText || '每个阶段 = 时长 + 各段灯效；设备按时间轴自动切换。暂停后「播放」从暂停处继续。'}}</text>
  </view>

  <!-- 设备上的剧本（QueryScript 摘要读回）：
       v3 只有摘要，没有整份读回——这一点必须写在界面上。 -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">设备上的剧本</text>
      <text class="section-value">{{summaryBusy ? '读取中…' : '摘要'}}</text>
    </view>

    <view class="summary-list">
      <view
        wx:for="{{scriptSummaries}}"
        wx:key="scriptId"
        class="summary-row {{item.scriptId === scriptId ? 'selected' : ''}} {{item.active ? 'active' : ''}}"
      >
        <text class="summary-title">{{item.title}}</text>
        <text class="summary-text">{{item.text}}</text>
      </view>
      <text wx:if="{{scriptSummaries.length === 0 && !summaryBusy}}" class="summary-empty">
        还没有读到摘要（连接设备后自动读取）
      </text>
    </view>

    <text wx:if="{{summaryErrorText}}" class="summary-error">{{summaryErrorText}}</text>
    <!-- 诚实说明：只能读摘要，内容读不回来 -->
    <text class="summary-note">{{summaryNote}}</text>

    <view class="btn-row">
      <button class="btn ghost" disabled="{{!ready || summaryBusy}}" bindtap="refreshSummaries">
        重新读取摘要
      </button>
    </view>
  </view>

  <view class="footer">
    <text class="version">v{{version}}</text>
    <text class="footer-hint">剧本跨灯带；段参数在「灯光 / 段编辑」页设置</text>
  </view>
</view>
