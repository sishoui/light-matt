/* 剧本页独有布局（共享外观在 app.wxss）。 */

.script-id-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 0 16rpx;
}

.script-id-label {
  font-size: 24rpx;
  color: var(--text-2);
}

.script-id {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 12rpx;
  background: var(--border);
  color: var(--text-2);
}

.script-id.selected {
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 600;
}

.script-id-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-2);
}

.script-stage-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.script-stage {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: var(--card-2);
  border: 1rpx solid var(--border);
}

.script-stage.selected {
  border-color: var(--accent);
}

.script-stage-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.script-stage-title {
  font-size: 26rpx;
  color: var(--text);
}

.script-stage-segments {
  font-size: 21rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.script-stage-side {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 阶段重排：顺序就是设备上的播放顺序 */
.script-stage-order {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-right: 10rpx;
}

.stage-move {
  width: 40rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: var(--border);
  color: var(--text-2);
}

.stage-move.off {
  opacity: 0.3;
}

.script-stage-strips {
  font-size: 21rpx;
  color: var(--accent);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.script-duration {
  width: 110rpx;
  padding: 6rpx 8rpx;
  font-size: 24rpx;
  text-align: right;
  border-radius: 8rpx;
  background: var(--card-2);
  color: var(--text);
  border: 1rpx solid var(--border);
}

.script-duration.invalid {
  border-color: var(--danger);
  color: var(--danger);
}

.script-duration-unit {
  font-size: 20rpx;
  color: var(--text-3);
}

.script-stage-delete {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--text-2);
  padding: 4rpx 8rpx;
}

/* 当前阶段的段明细 */
.stage-seg-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 4rpx;
}

.stage-seg-title {
  font-size: 22rpx;
  color: var(--text-2);
}

.stage-seg-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
}

.stage-seg-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-2);
  font-family: Menlo, Consolas, monospace;
}

.script-progress {
  margin-top: 14rpx;
}

.script-progress-bar {
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--border);
  overflow: hidden;
}

.script-progress-fill {
  height: 100%;
  background: var(--accent);
  transition: width 0.15s linear;
}

.script-progress-text {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-2);
}

.playback-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.playback-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  background: var(--border);
  color: var(--text-2);
}

.playback-btn.active {
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 600;
}

.playback-btn[disabled] {
  opacity: 0.45;
}

.playback-loop {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding-left: 6rpx;
}

.playback-loop-label {
  font-size: 22rpx;
  color: var(--text-2);
}

/* 容量预检（§10.4）：本地就能看到会不会超 16KB */
.capacity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: var(--card-2);
  border: 1rpx solid var(--border);
}

.capacity-text {
  font-size: 21rpx;
  color: var(--text-2);
}

.capacity-row.over {
  border-color: var(--danger);
}

.capacity-warn {
  font-size: 21rpx;
  color: var(--danger);
}

/* 设备上的剧本摘要（v3 只能读摘要） */
.summary-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: var(--card-2);
  border: 1rpx solid var(--border);
}

.summary-row.selected {
  border-color: var(--accent);
}

.summary-row.active {
  background: var(--accent-soft);
}

.summary-title {
  font-size: 25rpx;
  color: var(--text);
  min-width: 110rpx;
}

.summary-text {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-2);
}

.summary-empty {
  font-size: 22rpx;
  color: var(--text-3);
  padding: 10rpx 0;
}

.summary-error {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--danger);
}

.summary-note {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--text-3);
}

/* 自定义 tabBar 是 fixed 的，本页内容要让出它的高度。 */
.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
