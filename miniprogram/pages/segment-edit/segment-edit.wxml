<view class="page {{themeClass}}">
  <nav-bar
    title="{{stripTitle}} · {{segLabel}}"
    subtitle="{{linkText}} · {{ledCount}} 颗灯珠"
    back="{{true}}"
    large="{{false}}"
  />

  <!-- 连接状态（本页不提供连接入口：从设备控制页进来时已经连上） -->
  <view class="statusbar {{ready ? 'link-ready' : 'link-idle'}}">
    <view class="status-dot"></view>
    <view class="status-main">
      <text class="status-text">{{stripTitle}} · {{segLabel}}</text>
      <text class="status-sub">{{linkText}} · {{ledCount}} 颗灯珠</text>
    </view>
  </view>

  <!-- ============ 区间 + 逐灯珠示意 ============ -->
  <view class="section {{ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">灯珠区间</text>
      <text class="section-value">0 – {{ledCount > 0 ? ledCount - 1 : 0}}</text>
    </view>
    <view class="range-row">
      <input
        class="range-input"
        type="number"
        value="{{startInput}}"
        maxlength="2"
        placeholder="起点"
        disabled="{{!ready || busy}}"
        bindinput="onStartInput"
      />
      <text class="range-dash">–</text>
      <input
        class="range-input"
        type="number"
        value="{{endInput}}"
        maxlength="2"
        placeholder="终点"
        disabled="{{!ready || busy}}"
        bindinput="onEndInput"
      />
    </view>

    <!-- 每颗灯珠一格：高亮 = 草稿覆盖；彩色 = 同带已有段；红框 = 重叠 -->
    <view class="led-bar">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="led-cell {{item.covered ? 'covered' : ''}} {{item.conflict ? 'conflict' : ''}} {{item.ownerSegId >= 0 ? 'owned' : ''}}"
        style="{{item.ownerSegId >= 0 ? 'background:' + item.hex : ''}}"
      ></view>
    </view>
    <view class="led-legend">
      <view class="legend-item"><view class="legend-dot covered"></view><text>当前区间</text></view>
      <view class="legend-item"><view class="legend-dot owned"></view><text>同带已有段</text></view>
      <view class="legend-item"><view class="legend-dot conflict"></view><text>重叠</text></view>
    </view>
    <text class="section-hint">{{existingText}}</text>
  </view>

  <!-- ============ 第 1 层（必填） ============ -->
  <view
    wx:for="{{layerViews}}"
    wx:key="label"
    wx:for-index="layerIndex"
    wx:for-item="layer"
    class="section {{ready ? '' : 'disabled'}}"
  >
    <view class="section-head" data-layer="{{layerIndex}}" bindtap="onLayerCollapse">
      <text class="section-title">{{layer.label}}</text>
      <text class="section-value">{{layer.mode === 'off' ? '关闭' : (layer.mode === 'breathing' ? '呼吸' : (layer.mode === 'rainbow' ? '彩虹' : (layer.mode === 'comet' ? '流光' : '静态')))}} {{layer.collapsed ? '▸' : '▾'}}</text>
    </view>

    <block wx:if="{{!layer.collapsed}}">
      <!-- 层类型：第 2 层多一个「关闭」（第 1 层不提供，因为必填） -->
      <view class="chip-row">
        <view
          wx:for="{{layer.modeOptions}}"
          wx:for-item="option"
          wx:key="mode"
          class="chip {{layer.mode === option.mode ? 'selected' : ''}}"
          data-layer="{{layerIndex}}"
          data-type="{{option.type}}"
          bindtap="onLayerModeTap"
        >{{option.name}}</view>
      </view>

      <!-- 空层只显示一条说明：没有任何可编辑的参数（不存在第三层的入口） -->
      <text wx:if="{{layer.empty}}" class="section-hint">这一层关闭：只下发第 1 层，混合方式固定为「覆盖」。</text>

      <block wx:else>
        <!-- 呼吸：周期 / 最暗 / 波形 -->
        <view wx:if="{{layer.breathing}}" class="params">
          <view class="row">
            <text class="row-label">周期</text>
            <slider
              class="row-slider"
              min="0"
              max="{{maxPeriod}}"
              step="10"
              value="{{layer.periodMs}}"
              disabled="{{!ready || busy}}"
              activeColor="#4f8cff"
              backgroundColor="#2a2a32"
              block-size="20"
              data-layer="{{layerIndex}}"
              bindchange="onLayerPeriodChange"
            />
            <text class="row-value">{{layer.periodText}}</text>
          </view>
          <text class="section-hint">周期 0 = 静止；最短 {{layer.periodFloor}}ms（约 3Hz），低于下限会在提交前被拦下</text>

          <view class="row">
            <text class="row-label">最暗</text>
            <slider
              class="row-slider"
              min="0"
              max="255"
              step="1"
              value="{{layer.minLevel}}"
              disabled="{{!ready || busy}}"
              activeColor="#4f8cff"
              backgroundColor="#2a2a32"
              block-size="20"
              data-layer="{{layerIndex}}"
              bindchange="onLayerMinLevelChange"
            />
            <text class="row-value">{{layer.minLevelText}}</text>
          </view>

          <view class="chip-row tight">
            <view
              wx:for="{{layer.waveformOptions}}"
              wx:for-item="wave"
              wx:key="value"
              class="chip blue {{layer.waveform === wave.value ? 'selected' : ''}}"
              data-layer="{{layerIndex}}"
              data-value="{{wave.value}}"
              bindtap="onLayerWaveformTap"
            >{{wave.name}}</view>
          </view>
        </view>

        <!-- 彩虹：周期 / 跨度 / 方向 -->
        <view wx:if="{{layer.rainbow}}" class="params">
          <view class="row">
            <text class="row-label">周期</text>
            <slider
              class="row-slider"
              min="0"
              max="{{maxPeriod}}"
              step="10"
              value="{{layer.periodMs}}"
              disabled="{{!ready || busy}}"
              activeColor="#4f8cff"
              backgroundColor="#2a2a32"
              block-size="20"
              data-layer="{{layerIndex}}"
              bindchange="onLayerPeriodChange"
            />
            <text class="row-value">{{layer.periodText}}</text>
          </view>
          <text class="section-hint">周期 0 = 静止；最短 {{layer.periodFloor}}ms（5Hz）</text>

          <view class="row">
            <text class="row-label">跨度</text>
            <slider
              class="row-slider"
              min="0"
              max="255"
              step="1"
              value="{{layer.span}}"
              disabled="{{!ready || busy}}"
              activeColor="#4f8cff"
              backgroundColor="#2a2a32"
              block-size="20"
              data-layer="{{layerIndex}}"
              bindchange="onLayerSpanChange"
            />
            <text class="row-value">{{layer.spanText}}</text>
          </view>
          <text class="section-hint">0 = 整条同色，255 = 铺满整圈色相</text>

          <view class="chip-row tight">
            <view
              class="chip blue {{!layer.reverse ? 'selected' : ''}}"
              data-layer="{{layerIndex}}"
              data-value="0"
              bindtap="onLayerReverseTap"
            >正向</view>
            <view
              class="chip blue {{layer.reverse ? 'selected' : ''}}"
              data-layer="{{layerIndex}}"
              data-value="1"
              bindtap="onLayerReverseTap"
            >反向</view>
          </view>
        </view>

        <!-- 流光：周期 / 尾长 / 方向 -->
        <view wx:if="{{layer.comet}}" class="params">
          <view class="row">
            <text class="row-label">周期</text>
            <slider
              class="row-slider"
              min="0"
              max="{{maxPeriod}}"
              step="10"
              value="{{layer.periodMs}}"
              disabled="{{!ready || busy}}"
              activeColor="#4f8cff"
              backgroundColor="#2a2a32"
              block-size="20"
              data-layer="{{layerIndex}}"
              bindchange="onLayerPeriodChange"
            />
            <text class="row-value">{{layer.periodText}}</text>
          </view>
          <text class="section-hint">周期 0 = 静止；最短 {{layer.periodFloor}}ms（5Hz）</text>

          <view class="row">
            <text class="row-label">拖尾</text>
            <slider
              class="row-slider"
              min="0"
              max="255"
              step="1"
              value="{{layer.tail}}"
              disabled="{{!ready || busy}}"
              activeColor="#4f8cff"
              backgroundColor="#2a2a32"
              block-size="20"
              data-layer="{{layerIndex}}"
              bindchange="onLayerTailChange"
            />
            <text class="row-value">{{layer.tailText}}</text>
          </view>

          <view class="chip-row tight">
            <view
              class="chip blue {{!layer.reverse ? 'selected' : ''}}"
              data-layer="{{layerIndex}}"
              data-value="0"
              bindtap="onLayerReverseTap"
            >正向</view>
            <view
              class="chip blue {{layer.reverse ? 'selected' : ''}}"
              data-layer="{{layerIndex}}"
              data-value="1"
              bindtap="onLayerReverseTap"
            >反向</view>
          </view>
        </view>

        <!-- 基准色：该层自己的 hue+sat（四类灯效共用） -->
        <view class="layer-color">
          <view class="color-readout">
            <view class="swatch" style="background: {{layer.colorHex}}"></view>
            <text class="section-value mono">{{layer.colorHex}}</text>
          </view>
        </view>
        <view class="presets">
          <view
            wx:for="{{presetList}}"
            wx:for-item="preset"
            wx:key="name"
            class="preset {{layer.presetSelected[index] ? 'selected' : ''}}"
            data-layer="{{layerIndex}}"
            data-index="{{index}}"
            bindtap="onLayerPresetTap"
          >
            <view class="preset-dot" style="background: {{preset.hex}}"></view>
            <text class="preset-name">{{preset.name}}</text>
          </view>
        </view>
      </block>
    </block>
  </view>

  <!-- ============ blend：只有两层时可用 ============ -->
  <view class="section {{blendEnabled && ready ? '' : 'disabled'}}">
    <view class="section-head">
      <text class="section-title">混合方式</text>
      <text class="section-value">{{blend === 1 ? '相乘' : (blend === 2 ? '相加' : '覆盖')}}</text>
    </view>
    <view class="chip-row">
      <view
        wx:for="{{blendOptions}}"
        wx:key="value"
        class="chip {{blendEnabled && blend === item.value ? 'selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="onBlendTap"
      >{{item.name}}</view>
    </view>
    <text class="section-hint">{{blendHint}}</text>
    <text wx:if="{{!blendEnabled}}" class="section-hint">第 2 层关闭时协议要求 blend 必须为 0（覆盖），控件已禁用。</text>
  </view>

  <!-- ============ 实时预检 ============ -->
  <view wx:if="{{issueText}}" class="issue-box">
    <text class="issue-text">{{issueText}}</text>
  </view>

  <!-- ============ 操作 ============ -->
  <view class="btn-row">
    <button class="btn ghost" bindtap="onCancel">返回（丢弃草稿）</button>
    <button
      wx:if="{{segId >= 0}}"
      class="btn danger"
      disabled="{{!ready || busy}}"
      bindtap="onDelete"
    >删除此段</button>
    <button
      class="btn primary"
      disabled="{{!ready || busy || !canApply}}"
      bindtap="onApply"
    >{{busy ? '下发中…' : '应用'}}</button>
  </view>
  <text class="section-hint">{{hint}}</text>
</view>
