<!--
  参数区的唯一模板（简单档 + 进阶档背景层 + 进阶档特效层三处共用）。

  为什么用 template 而不是三份 wxml：
    - 三份一定会漂。之前简单档只有三个滑块、进阶档能调周期/尾巴/方向/波形，
      同一页里两套参数区，用户以为功能不一样。
    - 现在滑块与选择项都来自 effect-panel 的 SLIDER_KEYS / CHOICE_KEYS，
      这个模板只负责「把它们画出来」，不判断类型。

  参数：
    sliders  参数区滑块（PanelSliderView[]，含 track 渐变色）
    choices  选择项（PanelChoiceView[]）
    hueRamp  色相滑轨的彩虹渐变（不必每次从 JS 传）
    disabled 是否禁用（未连接 / 未选中分区）
    scope    事件名的前缀（"onPanel" / "onOverlay" / "onQuick"）

  WXML 的 template 不能拼接事件名，所以事件用统一的三个处理器 + data-scope
  分派；页面按 scope 决定改哪一层。
-->
<template name="effect-controls">
  <view wx:for="{{sliders}}" wx:for-item="slider" wx:key="key" class="param-row">
    <view class="param-head">
      <text class="param-label">{{slider.label}}</text>
      <text class="param-value mono">{{slider.display}}</text>
    </view>
    <!--
      滑轨按参数含义上色：色相是彩虹、饱和度是灰→当前色、亮度是黑→当前色、
      尾长是实色→透明。一条空拖动轴看不出在调什么。
    -->
    <view wx:if="{{slider.rainbow}}" class="hue-track" style="background: {{hueRamp}}">
      <slider
        class="param-slider hue-slider"
        min="{{slider.min}}"
        max="{{slider.max}}"
        step="{{slider.step}}"
        value="{{slider.value}}"
        data-key="{{slider.key}}"
        data-scope="{{scope}}"
        disabled="{{disabled}}"
        activeColor="rgba(0, 0, 0, 0)"
        backgroundColor="rgba(0, 0, 0, 0)"
        block-size="22"
        bindchanging="onScopeSliderChanging"
        bindchange="onScopeSliderChange"
      />
    </view>
    <view wx:elif="{{slider.track}}" class="track-wrap" style="background: {{slider.track}}">
      <slider
        class="param-slider track-slider"
        min="{{slider.min}}"
        max="{{slider.max}}"
        step="{{slider.step}}"
        value="{{slider.value}}"
        data-key="{{slider.key}}"
        data-scope="{{scope}}"
        disabled="{{disabled}}"
        activeColor="rgba(0, 0, 0, 0)"
        backgroundColor="rgba(0, 0, 0, 0)"
        block-size="22"
        bindchanging="onScopeSliderChanging"
        bindchange="onScopeSliderChange"
      />
    </view>
    <slider
      wx:else
      class="param-slider"
      min="{{slider.min}}"
      max="{{slider.max}}"
      step="{{slider.step}}"
      value="{{slider.value}}"
      data-key="{{slider.key}}"
      data-scope="{{scope}}"
      disabled="{{disabled}}"
      activeColor="{{accentColor}}"
      backgroundColor="rgba(120, 120, 128, 0.2)"
      block-size="22"
      bindchanging="onScopeSliderChanging"
      bindchange="onScopeSliderChange"
    />
    <text wx:if="{{slider.note}}" class="param-note">{{slider.note}}</text>
  </view>

  <view wx:for="{{choices}}" wx:for-item="choice" wx:key="key" class="panel-choice">
    <text class="param-label">{{choice.label}}</text>
    <view class="panel-choice-row">
      <view
        wx:for="{{choice.options}}"
        wx:for-item="choiceOption"
        wx:key="value"
        class="panel-option {{choiceOption.value === choice.value ? 'on' : ''}}"
        data-key="{{choice.key}}"
        data-value="{{choiceOption.value}}"
        data-scope="{{scope}}"
        bindtap="onScopeChoiceTap"
      >{{choiceOption.label}}</view>
    </view>
  </view>
</template>

<view class="page {{themeClass}}">
  <nav-bar title="{{title}}" subtitle="{{subtitle}}" back="{{true}}" />

  <!-- 连接提示：自动连接失败 / 需要先扫描时才有内容 -->
  <view wx:if="{{connectHint}}" class="notice-card" bindtap="onRetryConnect">
    <text class="notice-text">{{connectHint}}</text>
    <text class="notice-action">重试</text>
  </view>

  <view class="statusbar {{linkClass}}" bindtap="onRetryConnect">
    <view class="status-dot"></view>
    <view class="status-main">
      <text class="status-text">{{statusText}}</text>
      <text class="status-sub">{{statusSub}}</text>
    </view>
    <text
      wx:if="{{!ready && !connectBusy && (linkClass === 'link-idle' || linkClass === 'link-error')}}"
      class="status-action"
    >重连</text>
  </view>

  <!--
    应用失败 / 被预检拦住的原因（#125）。
    以前 `applyError` 有二十处赋值、wxml 里一处显示都没有——用户点了没反应，
    还看不到任何原因。现在它固定在页面顶部，写完就出现，成功后自动消失。
  -->
  <view wx:if="{{applyError}}" class="apply-error">
    <text class="apply-error-text">{{applyError}}</text>
    <text class="apply-error-close" bindtap="onDismissApplyError">知道了</text>
  </view>

  <!--
    顶部（#95）：标题 = 灯组自定义名（不再重复一行标题块）。
    右侧是灯珠数胶囊（**长按**弹圆盘）与三个圆形方案按钮；灯的开关在设备页。
  -->
  <view class="strip-head">
    <view class="strip-head-main">
      <text class="strip-name">{{title}}</text>
      <text class="strip-meta">{{ledText}}</text>
    </view>
    <view
      class="led-capsule {{ledBusy ? 'busy' : ''}}"
      bindlongpress="onLedCapsuleLongPress"
      hover-class="led-capsule-hover"
    >
      <text class="led-capsule-text mono">{{ledCapsule}}</text>
    </view>
  </view>

  <!--
    方案按钮（#95）：固定三个圆形数字，没有新增 / 删除入口。
    有内容的方案点了立即启用并播放；空方案不写设备（避免刷成空白）。
  -->
  <view class="plan-bar">
    <view class="plan-circles">
      <view
        wx:for="{{planCircles}}"
        wx:key="id"
        class="plan-circle {{item.selected ? 'on' : ''}} {{item.hasContent ? '' : 'empty'}}"
        data-plan-id="{{item.id}}"
        bindtap="onPlanTap"
        hover-class="plan-circle-hover"
      >
        <text class="plan-circle-label">{{item.label}}</text>
        <view wx:if="{{item.playing}}" class="plan-circle-dot"></view>
      </view>
    </view>
    <text class="plan-summary">{{planCircles[planSlot].summary}}</text>
    <text wx:if="{{planHint}}" class="plan-hint">{{planHint}}</text>
  </view>

  <!-- ---------------- 简单 / 进阶 ---------------- -->
  <view class="mode-switch">
    <view
      class="mode-tab {{mode === 'simple' ? 'on' : ''}}"
      data-mode="simple"
      bindtap="onModeTap"
    >
      <text class="mode-tab-label">简单</text>
      <text class="mode-tab-sub">点一下就好</text>
    </view>
    <view
      class="mode-tab {{mode === 'advanced' ? 'on' : ''}}"
      data-mode="advanced"
      bindtap="onModeTap"
    >
      <text class="mode-tab-label">进阶</text>
      <text class="mode-tab-sub">自己编排</text>
    </view>
  </view>

  <!-- ---------------- 简单档：一行一个灯效（#96） ----------------
       不再是色块网格：左边名称、右边当前值，点它从底部弹出滚轮。 -->
  <block wx:if="{{mode === 'simple'}}">
    <view class="section">
      <view class="section-head">
        <text class="section-title">灯效</text>
        <text class="section-value">整组生效</text>
      </view>

      <view class="effect-list {{quickDisabledReason ? 'disabled' : ''}}">
        <view
          wx:for="{{effectRows}}"
          wx:key="key"
          class="effect-row"
          data-key="{{item.key}}"
          bindtap="onEffectRowTap"
          hover-class="effect-row-hover"
        >
          <text class="effect-row-label">{{item.label}}</text>
          <view class="effect-row-value">
            <text class="effect-row-text">{{item.value}}</text>
            <view class="effect-row-chevron"></view>
          </view>
        </view>
      </view>

      <text wx:if="{{quickDisabledReason}}" class="section-hint">{{quickDisabledReason}}</text>
      <text wx:if="{{quickHint}}" class="section-hint">{{quickHint}}</text>
    </view>

    <!-- 参数区：与进阶档同一张模板，所以两边的配置项完全一致。 -->
    <view wx:if="{{simpleParams}}" class="section param-panel">
      <view class="section-head">
        <text class="section-title">{{simpleParams.title}}</text>
        <view class="param-preview" style="background: {{simpleParams.colorHex}}"></view>
      </view>

      <template
        is="effect-controls"
        data="{{
          sliders: simpleParams.sliders,
          choices: simpleParams.choices,
          hueRamp,
          disabled: !ready,
          accentColor,
          scope: 'quick'
        }}"
      />

      <text wx:if="{{simpleParams.notice}}" class="param-note">{{simpleParams.notice}}</text>
      <text wx:if="{{quickHint}}" class="section-hint">{{quickHint}}</text>
      <text wx:elif="{{!simpleParams.notice}}" class="section-hint">改完立刻生效，整组一起变</text>
    </view>
  </block>

  <!-- ---------------- 进阶档：时间轴 + 时长（#65） ---------------- -->
  <block wx:if="{{mode === 'advanced'}}">
    <view class="timeline-section">
      <!--
        #99：时间轴是页面结构，不包在卡片里。标题放大，步骤数与总秒数降为副标题；
        「加步骤」在标题右侧；没有「删步骤」按钮。循环是方案级设置，也放这一行。
      -->
      <view class="timeline-head">
        <view class="timeline-head-main">
          <text class="timeline-title">时间轴</text>
          <text class="timeline-sub">{{timelineSummary}}</text>
        </view>
        <view class="timeline-head-right">
          <view class="loop-control">
            <text class="loop-caption">循环</text>
            <view class="loop-options">
              <view
                wx:for="{{loopChoices}}"
                wx:key="value"
                class="loop-option {{item.selected ? 'on' : ''}} {{item.disabled ? 'disabled' : ''}}"
                data-value="{{item.value}}"
                bindtap="onLoopTap"
                hover-class="{{item.disabled ? 'none' : 'loop-option-hover'}}"
              >{{item.label}}</view>
            </view>
          </view>
          <!-- #133：加错了能撤回。至少留一步，只剩一步时按钮置灰。 -->
          <view
            class="timeline-add {{stepCount > 1 ? '' : 'disabled'}}"
            hover-class="{{stepCount > 1 ? 'timeline-add-hover' : ''}}"
            bindtap="onStepDelete"
          >− 步骤</view>
          <view
            class="timeline-add {{stepCanAdd ? '' : 'disabled'}}"
            hover-class="{{stepCanAdd ? 'timeline-add-hover' : ''}}"
            bindtap="onStepAdd"
          >+ 步骤</view>
        </view>
      </view>

      <!--
        每个步骤一个块，宽度按时长比例分配；点选、长按后横向拖动重排。
        行宽恒等于容器宽（#76）：八块时靠最小宽度 + 间隙降级 + 均分兜底，
        永不横向滚动，所以这里没有 scroll-view。

        `item.dragStyle` 是拖动位移（内联 transform）：被拖的块跟手指走并抬起，
        原位置到落点之间的块让出一格。位移量与落点都由 timeline.ts 的纯函数
        算出，页面不做算术（#82）。
      -->
      <view class="timeline-row {{timelineCompact ? 'compact' : ''}} {{timelineSettling ? 'settling' : ''}}">
        <view
          wx:for="{{steps}}"
          wx:key="key"
          class="timeline-block {{item.selected ? 'selected' : ''}} {{item.dragging ? 'dragging' : ''}} {{item.dropTarget ? 'drop-target' : ''}}"
          style="{{item.style}}{{item.dragStyle}}"
          data-index="{{item.index}}"
          bindtap="onStepTap"
          bindtouchstart="onStepTouchStart"
          bindtouchmove="onStepTouchMove"
          bindtouchend="onStepTouchEnd"
          bindtouchcancel="onStepTouchCancel"
        >
          <!-- 缩略色带：按这一步的分区灯珠比例铺满整条 -->
          <view class="timeline-bands">
            <view wx:for="{{item.bands}}" wx:for-item="band" wx:key="key" class="timeline-band" style="{{band.style}}"></view>
          </view>
          <text wx:if="{{item.showLabel}}" class="timeline-label">{{item.durationText}}</text>
          <text class="timeline-order">{{item.index + 1}}</text>
        </view>
      </view>

      <text class="timeline-hint">点一块选中，长按可拖动换位置</text>

      <!--
        #99 步骤气泡：选中步骤后出现在时间轴下方，箭头对准选中块正中。
        自上而下：步骤名（长按可改）→ 副标题（时长 · 分区数）→ 时长滑轴 → 分区列表。
      -->
      <view wx:if="{{bubble.visible}}" class="step-bubble">
        <view class="bubble-arrow" style="left: {{bubble.arrowPercent}}%"></view>
        <view class="bubble-name-row">
          <text class="bubble-name" bindlongpress="onStepRename">{{bubble.name}}</text>
          <text class="bubble-sub">{{bubble.subtitle}}</text>
        </view>

        <view class="duration-block">
          <view class="duration-head">
            <text class="duration-label">这一步时长</text>
            <text class="duration-value mono">{{stepDurationText}}</text>
          </view>
          <slider
            class="duration-slider"
            min="0.5"
            max="30"
            step="0.5"
            value="{{stepDurationSeconds}}"
            disabled="{{stepCount === 0}}"
            activeColor="{{accentColor}}"
            backgroundColor="rgba(120, 120, 128, 0.2)"
            block-size="24"
            bindchanging="onDurationChanging"
            bindchange="onDurationChange"
          />
          <view class="duration-ticks">
            <text
              wx:for="{{durationTicks}}"
              wx:key="key"
              class="duration-tick tick-{{item.align}}"
              style="left: {{item.percent}}%"
              data-ms="{{item.durationMs}}"
              bindtap="onDurationTickTap"
            >{{item.label}}</text>
          </view>
        </view>

        <!-- 分区列表：点一行展开该分区的背景层与特效层（两层编辑在下面）。 -->
        <view wx:if="{{bubble.zones.length > 0}}" class="bubble-zones">
          <view
            wx:for="{{bubble.zones}}"
            wx:key="segId"
            class="bubble-zone-row {{item.expanded ? 'expanded' : ''}}"
            data-seg-id="{{item.segId}}"
            bindtap="onBubbleZoneTap"
            hover-class="bubble-zone-hover"
          >
            <view class="bubble-zone-dot" style="background: {{item.hex}}"></view>
            <text class="bubble-zone-range mono">{{item.rangeText}}</text>
            <text class="bubble-zone-effect">{{item.effectText}}</text>
            <view class="bubble-zone-chevron"></view>
          </view>
        </view>
        <text wx:else class="bubble-empty">这一步还没有分区</text>
      </view>

      <text wx:if="{{stepHint}}" class="section-hint">{{stepHint}}</text>
    </view>

    <!-- ---------------- 进阶档：分区轴（#66） ---------------- -->
    <view class="section zone-section">
      <view class="section-head">
        <text class="section-title">分区</text>
        <view class="axis-head-right">
          <text class="section-value">{{zoneSummary}}</text>
          <view class="timeline-add preview-btn" bindtap="onPreviewToggle" hover-class="timeline-add-hover">预览</view>
          <view
            class="timeline-add zone-add {{zoneCanAdd ? '' : 'disabled'}}"
            hover-class="{{zoneCanAdd ? 'timeline-add-hover' : ''}}"
            bindtap="onZoneAdd"
          >+ 新增</view>
        </view>
      </view>

      <!--
        分区轴：每个分区按灯珠下标比例定位（left = 起点 / 灯珠数），没被覆盖的
        灯珠画成灰条（点不动）。选中态用 2px 描边而不是换底色——分区本身就有
        颜色，换底色会让人分不清「这是它的颜色」还是「它被选中了」。

        选中的那一块两端各挂一个圆形手柄（#77）：手柄是块的绝对定位子元素，
        位置是块内的 0% / 100%，所以**不改变块宽**，选中前后块的位置不跳动。
      -->
      <view class="zone-axis">
        <view
          wx:for="{{zoneBlocks}}"
          wx:key="key"
          class="zone-block {{item.kind === 'gap' ? 'zone-gap' : 'zone-solid'}} {{item.selected ? 'selected' : ''}}"
          style="{{item.style}}"
          data-seg-id="{{item.segId}}"
          bindtap="onZoneAxisTap"
          bindlongpress="onZoneAxisLongPress"
        >
          <view wx:if="{{item.kind === 'zone'}}" class="zone-fill" style="background: {{item.hex}}"></view>
          <text wx:if="{{item.showLabel}}" class="zone-label">{{item.label}}</text>
          <!-- 起止手柄：只有选中的分区才有（未选中时 handles 为空，不渲染节点）。 -->
          <view
            wx:for="{{item.handles}}"
            wx:for-item="handle"
            wx:key="kind"
            class="zone-handle {{handle.kind === 'start' ? 'handle-start' : 'handle-end'}} {{handle.crowded ? 'crowded' : ''}}"
            style="{{handle.style}}"
          ></view>
        </view>
      </view>

      <!--
        #97 预览条：按每个分区的颜色画出该组**每一颗灯珠**。
        只读聚合视图（不绑任何 touch 事件），与可编辑的分区轴刻意区分开。
      -->
      <view wx:if="{{previewOpen}}" class="preview-block">
        <view class="preview-head">
          <text class="preview-title">预览</text>
          <text class="preview-sub">每一颗灯珠按分区颜色画出，只读</text>
        </view>
        <view class="preview-strip">
          <view
            wx:for="{{previewLeds}}"
            wx:key="index"
            class="preview-led {{item.hex ? '' : 'empty'}} {{item.start ? 'is-start' : ''}} {{item.end ? 'is-end' : ''}}"
            style="{{item.hex ? 'background: ' + item.hex : ''}}"
          ></view>
        </view>
      </view>

      <!-- 零分区：给引导，而不是一条没有任何说明的灰条。 -->
      <view wx:if="{{zoneGuide}}" class="zone-guide">
        <text class="zone-guide-text">{{zoneGuide}}</text>
      </view>

      <!-- 选中区间的数字核对：第 0–19 颗 · 20 颗（与设备上的区间同一口径）。 -->
      <text wx:if="{{selectedZoneRangeDetail}}" class="zone-range-detail mono">{{selectedZoneRangeDetail}}</text>

      <view class="zone-meta">
        <text class="section-hint">{{selectedZoneText}}</text>
        <text class="zone-count">{{zoneCount}} / {{maxZones}}</text>
      </view>

      <view class="zone-actions">
        <!-- #97：没有「改范围」按钮——再点一次选中的分区（或长按）就进入编辑。 -->
        <text class="section-hint">点一块选中；再点一次（或长按）改范围</text>
      </view>

      <text wx:if="{{zoneHint}}" class="section-hint">{{zoneHint}}</text>
    </view>

    <!-- ---------------- 进阶档：两张卡（背景层 / 特效层） ----------------
         每个分区两个平级槽位，各自是**一张独立的卡片**，各自有完整的灯效种类
         与配置项（与简单档同源：滑块来自 SLIDER_KEYS、选择项来自 CHOICE_KEYS）。

         两层叠在一起时恒用「按亮度叠加」（§7.2.1）：特效层只盖住自己亮着的
         地方，其余位置继续显示背景层——流星亮处显流星、暗处露彩虹。界面上
         不再提供叠加方式选择器：覆盖会让流星把彩虹全遮了，相加会在重叠处发白，
         两者都不是用户要的效果。 -->
    <view class="section panel-section">
      <view class="section-head">
        <text class="section-title">背景层</text>
        <view class="panel-head-right">
          <text class="section-value">{{panelSummary}}</text>
          <view wx:if="{{panelColorHex}}" class="param-preview" style="background: {{panelColorHex}}"></view>
        </view>
      </view>

      <!--
        效果类型行在最上：八个等宽按钮（常亮 / 呼吸 / 彩虹 / 流星 / 爆闪 /
        心跳 / 随机闪烁 / 空）。切换后参数区**整体替换**（列表来自
        effect-panel.SLIDER_KEYS，页面不按类型写 wx:if 集合）。
      -->
      <view class="panel-types">
        <view
          wx:for="{{panelTypes}}"
          wx:key="type"
          class="panel-type {{item.selected ? 'on' : ''}} {{panelHasZone ? '' : 'disabled'}}"
          data-type="{{item.type}}"
          bindtap="onPanelTypeTap"
          hover-class="panel-type-hover"
        >{{item.name}}</view>
      </view>

      <block wx:if="{{panelHasZone}}">
        <!-- 「空」没有旋钮：只说明这一片不亮（它下发的是全零参数块）。 -->
        <view wx:if="{{panelNotice}}" class="panel-notice">
          <text class="panel-notice-text">{{panelNotice}}</text>
        </view>

        <template
          is="effect-controls"
          data="{{
            sliders: panelSliders,
            choices: panelChoices,
            hueRamp,
            disabled: !ready,
            accentColor,
            scope: 'panel'
          }}"
        />

        <text wx:if="{{panelHint}}" class="section-hint">{{panelHint}}</text>
      </block>
      <view wx:else class="panel-guide">
        <text class="panel-guide-text">{{panelGuide}}</text>
      </view>
    </view>

    <!-- ---------------- 进阶档：特效层（独立的第二张卡） ---------------- -->
    <view wx:if="{{panelHasZone}}" class="section panel-section overlay-card">
      <view class="section-head">
        <text class="section-title">特效层</text>
        <view class="panel-head-right">
          <text class="section-value">{{overlayEnabled ? overlaySummary : '空'}}</text>
          <view wx:if="{{overlayColorHex}}" class="param-preview" style="background: {{overlayColorHex}}"></view>
        </view>
      </view>

      <view class="panel-types">
        <view
          wx:for="{{overlayChoices}}"
          wx:key="value"
          class="panel-type {{overlayChoice === item.value ? 'on' : ''}}"
          data-value="{{item.value}}"
          bindtap="onOverlayTypeTap"
          hover-class="panel-type-hover"
        >{{item.name}}</view>
      </view>

      <block wx:if="{{overlayEnabled}}">
        <!-- 特效层的参数：与背景层**同一张模板**，所以两边的配置项一模一样。 -->
        <template
          is="effect-controls"
          data="{{
            sliders: overlaySlider,
            choices: overlayChoices2,
            hueRamp,
            disabled: !ready,
            accentColor,
            scope: 'overlay'
          }}"
        />
      </block>
      <text wx:else class="section-hint">这一层空着；选一个灯效就会叠在背景层上。</text>
    </view>

    <!-- 两条必须让用户知道的事实：内容只在本机 / 换机要重编 -->
    <view class="section panel-facts">
      <text class="facts-title">关于这套方案</text>
      <view wx:for="{{panelFacts}}" wx:key="*this" class="facts-row">
        <text class="facts-dot">·</text>
        <text class="facts-text">{{item}}</text>
      </view>
    </view>
  </block>

  <!-- ---------------- 灯珠弹窗（#66）：不进主界面，只在新增 / 改范围时出现 ---------------- -->
  <!-- ============ 灯效滚轮（#96）：点「灯效」行从底部弹出 ============ -->
  <view wx:if="{{effectWheelOpen}}" class="dial-mask" bindtap="onEffectWheelClose">
    <view class="dial-sheet wheel-sheet" catchtap="onDialStopPropagation">
      <view class="sheet-grabber"></view>
      <view class="dial-head">
        <text class="dial-title">选择灯效</text>
        <text class="dial-sub">选中立即生效</text>
      </view>
      <scroll-view scroll-y class="wheel-list">
        <view
          wx:for="{{effectOptions}}"
          wx:key="id"
          class="wheel-row {{item.selected ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onEffectPick"
          hover-class="wheel-row-hover"
        >
          <view class="wheel-row-main">
            <text class="wheel-row-name">{{item.name}}</text>
            <text class="wheel-row-hint">{{item.hint}}</text>
          </view>
          <view wx:if="{{item.check}}" class="wheel-row-check"></view>
        </view>
      </scroll-view>
      <view class="dial-cancel" bindtap="onEffectWheelClose">取消</view>
    </view>
  </view>

  <!-- ============ 灯珠数圆盘（#95）：长按胶囊打开，转动调整，松手下发 ============ -->
  <view wx:if="{{dialOpen}}" class="dial-mask" bindtap="onDialClose">
    <view class="dial-sheet" catchtap="onDialStopPropagation">
      <view class="sheet-grabber"></view>
      <view class="dial-head">
        <text class="dial-title">灯珠数</text>
        <text class="dial-sub">{{dialPending ? '松手后生效' : '转动圆盘调整'}}</text>
      </view>
      <view
        class="dial-face"
        bindtouchstart="onDialTouchStart"
        catchtouchmove="onDialTouchMove"
        bindtouchend="onDialTouchEnd"
        bindtouchcancel="onDialTouchEnd"
      >
        <view class="dial-ring"></view>
        <view wx:for="{{dialTicks}}" wx:key="value" class="dial-tick {{item.major ? 'major' : ''}}" style="transform: rotate({{(item.value - 1) * 3.6}}deg);">
          <view class="dial-tick-line"></view>
          <text wx:if="{{item.label}}" class="dial-tick-label">{{item.label}}</text>
        </view>
        <view class="dial-center">
          <text class="dial-value mono">{{dialValue}}</text>
          <text class="dial-unit">颗</text>
        </view>
      </view>
      <text class="dial-hint">范围 1–100；缩小到会裁掉分区时会先问你</text>
      <view class="dial-cancel" bindtap="onDialClose">取消</view>
    </view>
  </view>

  <view wx:if="{{pickerOpen}}" class="picker-mask" bindtap="onPickerMaskTap">
    <view class="picker-sheet" catchtap="onPickerStopPropagation">
      <view class="picker-head">
        <text class="picker-title">{{pickerTitle}}</text>
        <text class="picker-led">{{pickerLedText}}</text>
      </view>

      <text class="picker-range">{{pickerRangeText}}</text>

      <!-- 灯珠网格：一次渲染该灯组全部灯珠（有几颗画几颗）。
           起点 = 实心圆点 + 加粗数字，终点 = 空心圆环，区间内填半透明主题底色（#78）。 -->
      <view class="picker-grid" style="grid-template-columns: repeat({{pickerColumns}}, 1fr);">
        <view
          wx:for="{{pickerCells}}"
          wx:key="index"
          class="picker-cell {{item.disabled ? 'disabled' : ''}} {{item.selected ? 'selected' : ''}} {{item.anchor ? 'anchor' : ''}} {{item.start ? 'start' : ''}} {{item.end ? 'end' : ''}} {{item.conflict ? 'conflict' : ''}}"
          data-index="{{item.index}}"
          bindtap="onPickerCellTap"
        >
          <text class="picker-cell-no">{{item.label}}</text>
          <!-- 别人分区的格子置灰，只留一个小色点说明它归哪个分区。 -->
          <view
            wx:if="{{item.ownerHex}}"
            class="picker-owner-dot"
            style="background: {{item.ownerHex}}"
          ></view>
        </view>
      </view>

      <!-- 两个数字滚轮（#78）：值域只含与锚点连通的连续空闲灯珠，
           被别的分区占着的序号根本不出现在候选里，所以非法区间选不出来。 -->
      <view class="picker-wheels">
        <view class="picker-wheel">
          <text class="picker-wheel-tag">起点</text>
          <picker
            wx:if="{{pickerStartLabels.length > 0}}"
            class="picker-wheel-picker"
            mode="selector"
            range="{{pickerStartLabels}}"
            value="{{pickerStartIndex}}"
            bindchange="onPickerStartChange"
          >
            <view class="picker-wheel-value">
              <text class="picker-wheel-text">{{pickerStartText}}</text>
              <text class="picker-wheel-arrow">▾</text>
            </view>
          </picker>
          <text wx:else class="picker-wheel-empty">{{pickerStartHint}}</text>
        </view>

        <view class="picker-wheel {{pickerEndDisabled ? 'disabled' : ''}}">
          <text class="picker-wheel-tag">终点</text>
          <picker
            wx:if="{{!pickerEndDisabled && pickerEndLabels.length > 0}}"
            class="picker-wheel-picker"
            mode="selector"
            range="{{pickerEndLabels}}"
            value="{{pickerEndIndex}}"
            bindchange="onPickerEndChange"
          >
            <view class="picker-wheel-value">
              <text class="picker-wheel-text">{{pickerEndText}}</text>
              <text class="picker-wheel-arrow">▾</text>
            </view>
          </picker>
          <text wx:else class="picker-wheel-empty">{{pickerEndHint}}</text>
        </view>
      </view>

      <text wx:if="{{pickerError}}" class="picker-error">{{pickerError}}</text>

      <view class="picker-foot">
        <!-- #97：没有「取消」按钮——点空白处就关。 -->
        <button
          wx:if="{{pickerEditing}}"
          class="btn danger picker-btn"
          bindtap="onPickerDelete"
        >删除</button>
        <button
          class="btn primary picker-btn"
          disabled="{{!pickerCanConfirm}}"
          bindtap="onPickerConfirm"
        >确定</button>
      </view>
    </view>
  </view>

  <!--
    #96：没有「应用并播放」按钮。任何改动在防抖后立即生效；
    写入失败在页面顶部一行说明（不弹模态）。
  -->
  <view class="footer">
    <text class="footer-hint">灯效以灯控为准{{mock ? '（演示模式）' : ''}}</text>
  </view>
</view>
