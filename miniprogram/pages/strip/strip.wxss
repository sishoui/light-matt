/*
 * 灯组详情页（#64 简单档）。
 *
 * 共享外观（.section / .btn / .statusbar）在 app.wxss，这里只放本页独有布局。
 * 二级页不给 tabBar 留高度。颜色一律走 var(--…)，不写死 hex——
 * 写死会在某个主题下变白底白字（tests/theme.test.ts 每文件最多 4 处）。
 */

/* ---------------- 连接提示 ---------------- */

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-lg);
  background: var(--danger-soft);
}

.notice-text {
  flex: 1;
  font-size: 23rpx;
  color: var(--danger);
  line-height: 1.5;
}

.notice-action {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--danger);
  flex-shrink: 0;
}

/* ---------------- 顶部：灯组名 + 方案槽位 ---------------- */

.strip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 4rpx 0;
}

.strip-head-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.strip-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--text);
}

.strip-meta {
  font-size: 23rpx;
  color: var(--text-2);
}

/* 方案槽位按钮：点一下轮换 ①→②→③→④→①，空槽位写「空白」。 */
.plan-slot {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding: 14rpx 22rpx;
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: inset 0 0 0 1rpx var(--border);
  flex-shrink: 0;
}

.plan-slot-hover {
  background: var(--card-press);
}

.plan-slot-label {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text);
}

.plan-slot-sub {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ---------------- 简单 / 进阶 分段控件 ---------------- */

.mode-switch {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: var(--radius-lg);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.mode-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 8rpx;
  border-radius: var(--radius-md);
  transition: background 160ms ease;
}

.mode-tab.on {
  background: var(--card);
  box-shadow: var(--shadow);
}

.mode-tab-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
}

.mode-tab.on .mode-tab-label {
  color: var(--text);
}

.mode-tab-sub {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ---------------- 六张成品效果卡 ---------------- */

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.quick-grid.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.quick-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  transition: background 160ms ease;
}

.quick-card-hover {
  background: var(--card-press);
}

/* 选中态用描边 + 微底：色块本身就有颜色，不能靠颜色区分选中。 */
.quick-card.selected {
  background: var(--accent-soft);
  box-shadow: 0 0 0 2rpx var(--accent);
}

.quick-swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.quick-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.quick-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.quick-hint {
  font-size: 20rpx;
  color: var(--text-2);
  line-height: 1.4;
}

.quick-check {
  width: 26rpx;
  height: 14rpx;
  border-left: 4rpx solid var(--accent);
  border-bottom: 4rpx solid var(--accent);
  transform: rotate(-45deg) translateY(-4rpx);
  flex-shrink: 0;
}

/* ---------------- 参数区：色相 / 饱和度 / 亮度 ---------------- */

.param-panel {
  gap: 16rpx;
}

.param-preview {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx var(--border);
  flex-shrink: 0;
}

.param-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.param-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.param-label {
  font-size: 25rpx;
  color: var(--text-2);
}

.param-value {
  font-size: 25rpx;
  color: var(--text);
}

.param-slider {
  margin: 0;
}

/* 「固件更新后可用」这类限制说明：小字、不抢注意力但必须看得见。 */
.param-note {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ---------------- 进阶档：时间轴 ---------------- */

.timeline-section {
  gap: 18rpx;
}

/*
 * 时间轴容器。八段时 8×40px 保底 + 7 个间隙 = 376px，比多数手机可用宽度更宽，
 * 此时允许横向滚动（见 timeline.ts 的 timelineRowWidth），而不是把块压到点不到。
 */
.timeline-scroll {
  width: 100%;
  /* scroll-view 自己不给高度，显式定高，否则块会被压扁。 */
  height: 108rpx;
  white-space: nowrap;
}

.timeline-scroll.scrollable {
  /* 可滚动时留一条细边，提示「右边还有」。 */
  padding-bottom: 2rpx;
}

/*
 * 每个步骤一个块。宽度由 flex-grow 决定（页面算好像素后写进 style），
 * 行本身不换行：块再多也是横向排开。
 */
.timeline-row {
  display: flex;
  align-items: stretch;
  gap: 8px;
  height: 108rpx;
}

.timeline-block {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-width: 40px;
  box-sizing: border-box;
  padding: 10rpx 8rpx;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  overflow: hidden;
  transition: box-shadow 140ms ease;
}

/*
 * 选中态用 2px 描边，**不改颜色**：块里铺的是这一步光区的缩略色带，
 * 换底色会把色带本身盖掉。box-shadow 描边不占布局，块宽不会跳。
 */
.timeline-block.selected {
  box-shadow: 0 0 0 2px var(--accent);
}

/* 拖动中：被拖的块浮起来，落点块用虚线示意会排到这里。 */
.timeline-block.dragging {
  opacity: 0.7;
  z-index: 2;
}

.timeline-block.drop-target {
  box-shadow: 0 0 0 2px var(--blue);
}

/* 缩略色带：贴块底，按该步骤光区的灯珠比例分成若干条。 */
.timeline-bands {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6px;
  display: flex;
}

.timeline-band {
  height: 100%;
  /* 留白色带没有 background，用低饱和的底色兜底（深浅主题都看得见）。 */
  background: var(--border);
}

/* 时长文字：块太窄时页面把 showLabel 关掉，不会压到邻块上。 */
.timeline-label {
  position: relative;
  font-size: 20rpx;
  color: var(--text-2);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
}

/* 序号：永远看得见，是「这是第几个步骤」的唯一线索。 */
.timeline-order {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-3);
}

.timeline-block.selected .timeline-order {
  color: var(--accent);
}

.timeline-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.timeline-add {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: var(--radius-md);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.timeline-add-hover {
  background: var(--card-press);
}

/* 八段之后按钮不可用：变淡且不接收点击。 */
.timeline-add.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ---------------- 进阶档：时长拖拽条 ---------------- */

.duration-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.duration-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.duration-label {
  font-size: 25rpx;
  color: var(--text-2);
}

.duration-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.duration-slider {
  margin: 0;
}

/*
 * 三档刻度：绝对定位在轨道两端与中间。两端贴边（不越出容器），中间居中，
 * 否则「0.5 秒」会被裁成「5 秒」。
 */
.duration-ticks {
  position: relative;
  height: 30rpx;
}

.duration-tick {
  position: absolute;
  top: 0;
  font-size: 19rpx;
  color: var(--text-3);
  line-height: 30rpx;
  white-space: nowrap;
}

.duration-tick.tick-first {
  transform: translateX(0);
}

.duration-tick.tick-mid {
  transform: translateX(-50%);
}

.duration-tick.tick-last {
  transform: translateX(-100%);
}

/* ---------------- 进阶档占位 ---------------- */

.placeholder-card {
  padding: 48rpx 36rpx;
  gap: 12rpx;
}

.placeholder-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.placeholder-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
}

/* ---------------- 进阶档：光区轴（#66） ---------------- */

.zone-section {
  gap: 16rpx;
}

.axis-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/*
 * 光区轴的容器：块在里面绝对定位（left / width 由 zone-axis.ts 按灯珠比例
 * 算好写进 style）。相对定位是必须的，否则 left 会相对整页算。
 */
.zone-axis {
  position: relative;
  height: 76rpx;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  overflow: hidden;
}

.zone-block {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 4rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

/* 光区本体：颜色只铺在块里，块的选中态另加描边（不换色）。 */
.zone-fill {
  position: absolute;
  top: 4rpx;
  bottom: 4rpx;
  left: 2rpx;
  right: 2rpx;
  border-radius: var(--radius-sm);
}

/*
 * 选中态：2px 描边，不改颜色（光区自身就有颜色，换底色会混淆）——
 * 与 `.timeline-block.selected` 同一套处理方式。z-index 抬起来，
 * 否则窄光区的描边会被邻块盖住一半。
 */
.zone-block.selected {
  z-index: 2;
  box-shadow: inset 0 0 0 2px var(--accent);
}

/* 没被覆盖的灯珠：灰条（走 --border，深浅主题都看得见），点不动。 */
.zone-gap {
  background: var(--border);
  pointer-events: none;
}

.zone-label {
  position: relative;
  font-size: 19rpx;
  font-weight: 600;
  color: var(--accent-ink);
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.45);
  white-space: nowrap;
  overflow: hidden;
}

.zone-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.zone-count {
  font-size: 21rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.zone-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.timeline-actions-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 「删步骤」是次要动作：底色退到卡片色，不抢「+ 加步骤」的注意力。 */
.timeline-add.ghost {
  background: transparent;
  color: var(--text-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

/* ---------------- 灯珠弹窗（#66） ---------------- */

.picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.picker-sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 86vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  background: var(--bg-elevated);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.picker-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.picker-led {
  font-size: 21rpx;
  color: var(--text-3);
}

.picker-range {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-2);
}

/* 12 列网格：列数由页面写进 style，这里只管间距与格子。 */
.picker-grid {
  display: grid;
  gap: 8rpx;
}

/*
 * 一格灯珠。宽度由网格均分；高度固定（不用 aspect-ratio——低版本基础库
 * 不支持，格子会塌成零高）。
 */
.picker-cell {
  position: relative;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  line-height: 1;
}

.picker-cell-no {
  font-size: 18rpx;
  color: var(--text-3);
}

/* 属于其它光区时的小色点：置灰之后仍然看得出「它归哪一块」。 */
.picker-owner-dot {
  position: absolute;
  top: 3rpx;
  right: 3rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

/* 属于其它光区：置灰且点不动（不靠颜色深浅，靠斑马纹与降低不透明度）。 */
.picker-cell.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 选中的灯珠：描边 + 提亮（选中不是颜色变化，与光区轴同一套语义）。 */
.picker-cell.selected {
  box-shadow: 0 0 0 2px var(--accent);
}

.picker-cell.selected .picker-cell-no {
  color: var(--text);
}

/* 锚点（第一次点的那一颗）：实心小点，告诉用户「起点在这里」。 */
.picker-cell.anchor::after {
  content: "";
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent-ink);
}

.picker-cell.conflict {
  box-shadow: 0 0 0 2px var(--danger);
}

.picker-error {
  font-size: 22rpx;
  color: var(--danger);
  line-height: 1.5;
}

.picker-foot {
  display: flex;
  gap: 12rpx;
}

.picker-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 27rpx;
}

/* ---------------- 底部：应用并播放 ---------------- */

.apply-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.apply-play {
  width: 100%;
}

/* 写入失败就地说明原因（不弹模态）。 */
.apply-error {
  font-size: 22rpx;
  color: var(--danger);
  line-height: 1.5;
}

/* 「这个档位还用不了」这类说明：小字、不抢注意力但必须看得见。 */
.apply-note {
  font-size: 21rpx;
  color: var(--text-3);
  line-height: 1.5;
}
