/*
 * 灯组详情页（#64 简单档）。
 *
 * 共享外观（.section / .btn / .statusbar）在 app.wxss，这里只放本页独有布局。
 * 二级页不给 tabBar 留高度。颜色一律走 var(--…)，不写死 hex——
 * 写死会在某个主题下变白底白字（tests/theme.test.ts 每文件最多 4 处）。
 */

/* ---------------- 连接提示 ---------------- */

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-lg);
  background: var(--danger-soft);
}

.notice-text {
  flex: 1;
  font-size: 23rpx;
  color: var(--danger);
  line-height: 1.5;
}

.notice-action {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--danger);
  flex-shrink: 0;
}

/* ---------------- 顶部：灯组名 + 方案槽位 ---------------- */

.strip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 4rpx 0;
}

.strip-head-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.strip-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--text);
}

.strip-meta {
  font-size: 23rpx;
  color: var(--text-2);
}

/* 方案槽位按钮：点一下轮换 ①→②→③→④→①，空槽位写「空白」。 */
.plan-slot {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding: 14rpx 22rpx;
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: inset 0 0 0 1rpx var(--border);
  flex-shrink: 0;
}

.plan-slot-hover {
  background: var(--card-press);
}

.plan-slot-label {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text);
}

.plan-slot-sub {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ---------------- 简单 / 进阶 分段控件 ---------------- */

.mode-switch {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: var(--radius-lg);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.mode-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 8rpx;
  border-radius: var(--radius-md);
  transition: background 160ms ease;
}

.mode-tab.on {
  background: var(--card);
  box-shadow: var(--shadow);
}

.mode-tab-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
}

.mode-tab.on .mode-tab-label {
  color: var(--text);
}

.mode-tab-sub {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ---------------- 六张成品效果卡 ---------------- */

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.quick-grid.disabled {
  opacity: 0.45;
  pointer-events: none;
}

.quick-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  transition: background 160ms ease;
}

.quick-card-hover {
  background: var(--card-press);
}

/* 选中态用描边 + 微底：色块本身就有颜色，不能靠颜色区分选中。 */
.quick-card.selected {
  background: var(--accent-soft);
  box-shadow: 0 0 0 2rpx var(--accent);
}

.quick-swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.quick-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.quick-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.quick-hint {
  font-size: 20rpx;
  color: var(--text-2);
  line-height: 1.4;
}

.quick-check {
  width: 26rpx;
  height: 14rpx;
  border-left: 4rpx solid var(--accent);
  border-bottom: 4rpx solid var(--accent);
  transform: rotate(-45deg) translateY(-4rpx);
  flex-shrink: 0;
}

/* ---------------- 参数区：色相 / 饱和度 / 亮度 ---------------- */

.param-panel {
  gap: 16rpx;
}

.param-preview {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx var(--border);
  flex-shrink: 0;
}

.param-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.param-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.param-label {
  font-size: 25rpx;
  color: var(--text-2);
}

.param-value {
  font-size: 25rpx;
  color: var(--text);
}

.param-slider {
  margin: 0;
}

/* 滑块下方的补充说明（当前所有滑块都直接生效，所以通常不出现）。 */
.param-note {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ---------------- 进阶档：时间轴 ---------------- */

.timeline-section {
  gap: 18rpx;
}

/*
 * 每个步骤一个块。宽度由 flex-grow 决定（页面算好像素后写进 style），
 * 行宽恒等于容器宽（页面把块宽之和 + 间隙算到正好填满），不换行也不滚动。
 */
.timeline-row {
  display: flex;
  align-items: stretch;
  gap: 8px;
  width: 100%;
  height: 108rpx;
}

/* 窄容器（最小宽度 + 8px 间隙放不下）：页面把间隙降到 4px。 */
.timeline-row.compact {
  gap: 4px;
}

.timeline-block {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  /*
   * 不写 min-width：块宽由页面以像素内联（`flex: <px> 0 0%`），「算出来的宽度」
   * 和「显示宽度」必须是同一份真相。未测量时的首帧由页面内联的
   * `min-width: 24px` 兜底（见 timeline.ts 的 flexStyle）。
   */
  box-sizing: border-box;
  padding: 10rpx 8rpx;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  overflow: hidden;
  transition: box-shadow 140ms ease;
}

/*
 * 选中态用 2px 描边，**不改颜色**：块里铺的是这一步光区的缩略色带，
 * 换底色会把色带本身盖掉。box-shadow 描边不占布局，块宽不会跳。
 */
.timeline-block.selected {
  box-shadow: 0 0 0 2px var(--accent);
}

/* 拖动中：被拖的块浮起来，落点块用虚线示意会排到这里。 */
.timeline-block.dragging {
  opacity: 0.7;
  z-index: 2;
}

.timeline-block.drop-target {
  box-shadow: 0 0 0 2px var(--blue);
}

/* 缩略色带：贴块底，按该步骤光区的灯珠比例分成若干条。 */
.timeline-bands {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6px;
  display: flex;
}

.timeline-band {
  height: 100%;
  /* 留白色带没有 background，用低饱和的底色兜底（深浅主题都看得见）。 */
  background: var(--border);
}

/* 时长文字：块太窄时页面把 showLabel 关掉，不会压到邻块上。 */
.timeline-label {
  position: relative;
  font-size: 20rpx;
  color: var(--text-2);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
}

/* 序号：永远看得见，是「这是第几个步骤」的唯一线索。 */
.timeline-order {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-3);
}

.timeline-block.selected .timeline-order {
  color: var(--accent);
}

.timeline-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.timeline-add {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: var(--radius-md);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.timeline-add-hover {
  background: var(--card-press);
}

/* 八段之后按钮不可用：变淡且不接收点击。 */
.timeline-add.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ---------------- 进阶档：时长拖拽条 ---------------- */

.duration-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.duration-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.duration-label {
  font-size: 25rpx;
  color: var(--text-2);
}

.duration-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.duration-slider {
  margin: 0;
}

/*
 * 三档刻度：绝对定位在轨道两端与中间。两端贴边（不越出容器），中间居中，
 * 否则「0.5 秒」会被裁成「5 秒」。
 */
.duration-ticks {
  position: relative;
  height: 30rpx;
}

.duration-tick {
  position: absolute;
  top: 0;
  font-size: 19rpx;
  color: var(--text-3);
  line-height: 30rpx;
  white-space: nowrap;
}

.duration-tick.tick-first {
  transform: translateX(0);
}

.duration-tick.tick-mid {
  transform: translateX(-50%);
}

.duration-tick.tick-last {
  transform: translateX(-100%);
}

/* ---------------- 进阶档：光区轴（#66） ---------------- */

.zone-section {
  gap: 16rpx;
}

.axis-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/*
 * 光区轴的容器：块在里面绝对定位（left / width 由 zone-axis.ts 按灯珠比例
 * 算好写进 style）。相对定位是必须的，否则 left 会相对整页算。
 */
.zone-axis {
  position: relative;
  height: 76rpx;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  /*
   * 不能 overflow:hidden：起止手柄比条带高，会被裁掉一半（#77）。
   * 条带自身的圆角由 .zone-fill 的 border-radius 负责。
   */
  overflow: visible;
}

.zone-block {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 4rpx;
  border-radius: var(--radius-sm);
  /* 手柄挂在块外沿，必须放行，否则选中后两端圆点被切掉。 */
  overflow: visible;
}

/* 光区本体：颜色只铺在块里，块的选中态另加描边（不换色）。 */
.zone-fill {
  position: absolute;
  top: 4rpx;
  bottom: 4rpx;
  left: 2rpx;
  right: 2rpx;
  border-radius: var(--radius-sm);
}

/*
 * 选中态：2px 描边，不改颜色（光区自身就有颜色，换底色会混淆）——
 * 与 `.timeline-block.selected` 同一套处理方式。z-index 抬起来，
 * 否则窄光区的描边会被邻块盖住一半。
 */
.zone-block.selected {
  z-index: 2;
  box-shadow: inset 0 0 0 2px var(--accent);
}

/* 没被覆盖的灯珠：灰条（走 --border，深浅主题都看得见），点不动。 */
.zone-gap {
  background: var(--border);
  pointer-events: none;
}

/*
 * 起止手柄（#77）：选中光区的两端各一个实心圆，比条带更高，一眼看出
 * 「起点在这一端、终点在这一端」。
 *
 * 三个必须：
 *  1. 绝对定位 + 块内 left 0% / 100%，**不参与块宽计算**——选中不让块变宽；
 *  2. 圆形用 border-radius:50%，不是图片，主题换了颜色自动跟；
 *  3. 位置用 translateX(-50%) 圆心中在块边上，起点才真的指在「第一颗的左边」。
 */
.zone-handle {
  position: absolute;
  /* 圆心落在条带上沿：一半在条带上方，所以「高于条带」但不压住块内文字。 */
  top: -13rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--accent);
  border: 3rpx solid var(--card);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
  transform: translateX(-50%);
  z-index: 3;
  /* 手柄只是指示器：点它等于点块，不能挡住块的点击。 */
  pointer-events: none;
}

/*
 * 两端挨得太近（单颗光区 / 灯珠很密）：缩小手柄并各自**向外**错开，
 * 让两个圆仍然分得清哪边是起点、哪边是终点，而不是叠成一团。
 */
.zone-handle.crowded {
  width: 18rpx;
  height: 18rpx;
  top: -8rpx;
}

.zone-handle.crowded.handle-start {
  transform: translateX(-100%);
}

.zone-handle.crowded.handle-end {
  transform: translateX(0);
}

/* 零光区的引导：轴下面给出下一步，而不是只有一根灰条。 */
.zone-guide {
  display: flex;
  justify-content: center;
  padding: 2rpx 0;
}

.zone-guide-text {
  font-size: 23rpx;
  color: var(--text-3);
  text-align: center;
}

/* 选中区间的数字核对（与设备上的区间同一口径）。 */
.zone-range-detail {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-2);
  letter-spacing: 0.5rpx;
}

.zone-label {
  position: relative;
  font-size: 19rpx;
  font-weight: 600;
  color: var(--accent-ink);
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.45);
  white-space: nowrap;
  overflow: hidden;
}

.zone-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.zone-count {
  font-size: 21rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.zone-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.timeline-actions-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 「删步骤」是次要动作：底色退到卡片色，不抢「+ 加步骤」的注意力。 */
.timeline-add.ghost {
  background: transparent;
  color: var(--text-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

/* ---------------- 进阶档：效果面板（#67） ---------------- */

.panel-section {
  gap: 16rpx;
}

.panel-head-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

/* 类型行：四个等宽按钮。选中态用底色 + 描边，不靠字号变化（会挤动布局）。 */
.panel-types {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.panel-type {
  flex: 1 1 0;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-2);
  transition: background 160ms ease;
}

.panel-type.on {
  background: var(--accent);
  color: var(--accent-ink);
  box-shadow: 0 0 0 2rpx var(--accent);
}

.panel-type-hover {
  background: var(--card-press);
}

/* 没有可选的光区时，类型行整体变淡且点不动（引导文字会说明原因）。 */
.panel-type.disabled {
  opacity: 0.45;
  pointer-events: none;
}

/*
 * 色相滑轨的彩虹底。slider 盖在上面，轨道与已滑过部分都设成透明，
 * 让底下的渐变透出来——这样「滑到哪就是什么颜色」一眼可见。
 */
.hue-track {
  border-radius: 999rpx;
  padding: 0 18rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
}

.hue-slider {
  flex: 1;
  margin: 0;
}

/* 波形 / 方向：一行选项按钮，与类型行同一套选中语义。 */
.panel-choice {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.panel-choice-row {
  display: flex;
  gap: 8rpx;
}

.panel-option {
  flex: 1 1 0;
  text-align: center;
  padding: 14rpx 0;
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  color: var(--text-2);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.panel-option.on {
  color: var(--accent-ink);
  background: var(--accent);
  font-weight: 600;
}

/* 没得编辑时的引导卡：不是一片空白，而是告诉用户下一步做什么。 */
.panel-guide {
  padding: 28rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.panel-guide-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
}

/* 两条必须让用户知道的事实：内容只在本机、换机要重编。 */
.panel-facts {
  gap: 8rpx;
}

.facts-title {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-2);
}

.facts-row {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.facts-dot {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.6;
}

.facts-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-3);
}

/* ---------------- 灯珠弹窗（#66） ---------------- */

.picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.picker-sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 86vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  background: var(--bg-elevated);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.picker-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.picker-led {
  font-size: 21rpx;
  color: var(--text-3);
}

.picker-range {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-2);
}

/* 12 列网格：列数由页面写进 style，这里只管间距与格子。
   100 颗时是 9 行，加上底部两个滚轮会超过 86vh 的弹窗高度——网格自己滚，
   标题、区间文字、滚轮与按钮都留在视野里（滚轮不能跟着一起滚走）。 */
.picker-grid {
  display: grid;
  gap: 8rpx;
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding: 2rpx;
}

/*
 * 一格灯珠。宽度由网格均分；高度固定（不用 aspect-ratio——低版本基础库
 * 不支持，格子会塌成零高）。
 */
.picker-cell {
  position: relative;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
  line-height: 1;
}

.picker-cell-no {
  font-size: 18rpx;
  color: var(--text-3);
}

/* 属于其它光区时的小色点：置灰之后仍然看得出「它归哪一块」。 */
.picker-owner-dot {
  position: absolute;
  top: 3rpx;
  right: 3rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

/* 属于其它光区：置灰且点不动（不靠颜色深浅，靠斑马纹与降低不透明度）。 */
.picker-cell.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 选中的灯珠：半透明主题底色（区间整体一眼可见，不盖住格子上的数字）。 */
.picker-cell.selected {
  background: var(--accent-soft);
  box-shadow: inset 0 0 0 1rpx var(--accent);
}

.picker-cell.selected .picker-cell-no {
  color: var(--text);
}

/*
 * 起点 / 终点（#78）：区间两端各画一个圆，靠「实心 / 空心」而不是颜色区分。
 *  - 起点：实心圆点 + 加粗数字（数字压在圆点上，颜色用 accent-ink 保证对比）；
 *  - 终点：空心圆环（只有描边，格子底色透出来）。
 *
 * 两条规则各写一份几何属性：多选择器共用块会让「起点实心 / 终点空心」这两条
 * 差异被藏在第二个块里，渲染层测试也就只能读到空声明（见 led-picker.test.ts）。
 */
.picker-cell.start::before {
  content: "";
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--accent);
}

.picker-cell.end::before {
  content: "";
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 3rpx solid var(--accent);
  background: transparent;
}

.picker-cell.start .picker-cell-no,
.picker-cell.end .picker-cell-no {
  position: relative;
  z-index: 1;
}

.picker-cell.start .picker-cell-no {
  font-weight: 700;
  color: var(--accent-ink);
}

.picker-cell.end .picker-cell-no {
  font-weight: 700;
  color: var(--accent);
}

/* 锚点（第一次点、还没定区间的那一颗）：实心小点，告诉用户「起点在这里」。
   一旦有了区间就由 start / end 表达两端，不再叠一个点（会盖住数字）。 */
.picker-cell.anchor::after {
  content: "";
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent-ink);
}

.picker-cell.anchor.start::after,
.picker-cell.anchor.end::after {
  display: none;
}

.picker-cell.conflict {
  box-shadow: 0 0 0 2px var(--danger);
}

/* 起点 / 终点两个数字滚轮（#78）。 */
.picker-wheels {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}

.picker-wheel {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 12rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--card-2);
  box-shadow: inset 0 0 0 1rpx var(--border);
}

.picker-wheel-tag {
  font-size: 20rpx;
  color: var(--text-3);
}

.picker-wheel-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.picker-wheel-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.picker-wheel-arrow {
  font-size: 20rpx;
  color: var(--text-3);
}

.picker-wheel-empty {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 终点滚轮在锚点未定 / 没有空闲灯珠时不可用：整块降透明度。 */
.picker-wheel.disabled {
  opacity: 0.5;
}

.picker-error {
  font-size: 22rpx;
  color: var(--danger);
  line-height: 1.5;
}

.picker-foot {
  display: flex;
  flex-shrink: 0;
  gap: 12rpx;
}

.picker-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 27rpx;
}

/* ---------------- 底部：应用并播放 ---------------- */

.apply-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.apply-play {
  width: 100%;
}

/* 写入失败就地说明原因（不弹模态）。 */
.apply-error {
  font-size: 22rpx;
  color: var(--danger);
  line-height: 1.5;
}
